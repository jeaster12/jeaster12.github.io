---
import { Icon } from 'astro-icon/components';
---

<!-- Team Composition -->
<div class="card-blue">
  <h3 class="font-bold text-gray-900 mb-2 flex items-center gap-2 dark:text-gray-200">
    <Icon name="line-md:account" class="text-blue-600 text-xl dark:text-blue-600" />
    Team Structure
  </h3>

  <div class="space-y-4">
    <div class="bg-white/70 rounded-lg p-4 dark:bg-black/20">
      <div class="flex items-center justify-between mb-2">
        <h4 class="font-semibold text-gray-900 mb-0 dark:text-gray-200">Core Team: 7 Engineers</h4>
        <span class="text-xs bg-purple-600/10 text-purple-600 px-2 py-1 rounded-full font-medium">Direct Reports</span>
      </div>
      <div class="space-y-2 text-sm text-gray-700 dark:text-gray-400">
        <div class="flex items-start gap-2">
          <Icon name="line-md:chevron-small-right" class="text-purple-600 mt-0.5 flex-shrink-0" />
          <span><strong>1 Staff Engineer</strong> - Platform architecture & technical strategy</span>
        </div>
        <div class="flex items-start gap-2">
          <Icon name="line-md:chevron-small-right" class="text-purple-600 mt-0.5 flex-shrink-0" />
          <span><strong>3 Senior Engineers</strong> - AI pipeline, infrastructure, frontend tooling</span>
        </div>
        <div class="flex items-start gap-2">
          <Icon name="line-md:chevron-small-right" class="text-purple-600 mt-0.5 flex-shrink-0" />
          <span><strong>2 Mid-level Engineers</strong> - Feature development, testing, docs</span>
        </div>
        <div class="flex items-start gap-2">
          <Icon name="line-md:chevron-small-right" class="text-purple-600 mt-0.5 flex-shrink-0" />
          <span><strong>1 Junior Engineer</strong> - Tooling integrations, developer experience</span>
        </div>
      </div>
    </div>

    <div class="bg-white/70 rounded-lg p-4 dark:bg-black/20">
      <div class="flex items-center justify-between mb-2">
        <h4 class="font-semibold text-gray-900 mb-0 dark:text-gray-200">Extended Team: 12+ Contributors</h4>
        <span class="text-xs bg-purple-100 text-purple-700 px-2 py-1 rounded-full font-medium dark:bg-purple-600/10 dark:text-purple-600">Cross-functional</span>
      </div>
      <div class="text-sm text-gray-700 dark:text-gray-400">
        <div class="flex items-start gap-2">
          <Icon name="line-md:chevron-small-right" class="text-purple-600 mt-0.5 flex-shrink-0" />
          <span>UX Design (3), Platform Engineering (4), Product (5+)</span>
        </div>
        <p class="text-xs text-gray-800 italic dark:text-gray-400">Coordinated contributors across orgs with ownership & lightweight ceremonies</p>
      </div>
    </div>
  </div>
</div>