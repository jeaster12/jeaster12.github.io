---
import { Image } from 'astro:assets';
import { globalConfig } from '@/data/content'
---

<footer class="bg-white dark:bg-boxDark ">
  <div class="py-2 flex items-center sm:flex-row flex-col container max-w-[1320px] mx-auto px-5 xl:px-3">
    <a href="/" class="flex title-font font-medium items-center md:justify-start justify-center text-gray-900">
      <Image
        width={120}
        height={40}
        loading="lazy"
        src={globalConfig.logo.src}
        alt={globalConfig.logo.alt}
        class="h-10 w-auto dark:brightness-0 dark:invert"
      />
    </a>
    <span class="inline-flex sm:ml-auto sm:mt-0 mt-4 justify-center sm:justify-start">
      <span class="text-gray-500 dark:text-white text-sm">
        © 2025 {globalConfig.name}
      </span>
    </span>
  </div>
</footer>