---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import ProjectDetails from '../../components/portfolio/ProjectDetails.astro';
import TechStack from '../../components/portfolio/TechStack.astro';
import FeatureCard from '../../components/portfolio/FeatureCard.astro';
import ContentSection from '../../components/portfolio/ContentSection.astro';
import BenefitsSection from '../../components/portfolio/BenefitsSection.astro';
import ImageGallery from '../../components/portfolio/ImageGallery.astro';

const features = [
  { icon: "green", text: "Interactive component playground" },
  { icon: "green", text: "Auto-generated API documentation" },
  { icon: "green", text: "Live code examples with syntax highlighting" },
  { icon: "green", text: "Design token visualization" },
  { icon: "green", text: "Multi-framework code samples" },
  { icon: "green", text: "Responsive testing environment" }
];

const metrics = [
  { icon: "blue", text: "500+ component examples documented" },
  { icon: "blue", text: "95% developer adoption rate" },
  { icon: "blue", text: "50% reduction in support tickets" }
];

const techCategories = [
  {
    title: "Frontend Stack",
    technologies: [
      { name: "React", gradient: "from-blue-500 to-cyan-500" },
      { name: "Next.js", gradient: "from-gray-600 to-gray-800" },
      { name: "TypeScript", gradient: "from-yellow-500 to-orange-500" }
    ]
  },
  {
    title: "Documentation Tools",
    technologies: [
      { name: "MDX", gradient: "from-blue-600 to-purple-600" },
      { name: "Storybook", gradient: "from-orange-500 to-red-500" },
      { name: "Docusaurus", gradient: "from-green-500 to-emerald-500" }
    ]
  }
];

const documentationFeatures = [
  {
    title: "Component Playground",
    description: "Live editor where developers can modify component props and see changes instantly.",
    image: "/storybookA.jpg",
    imageAlt: "Storybook Component Playground",
    borderColor: "green"
  },
  {
    title: "Angular Integration",
    description: "Comprehensive Angular component examples with TypeScript implementations.",
    image: "/docs-angular.jpg",
    imageAlt: "Angular Documentation Examples",
    borderColor: "blue"
  },
  {
    title: "Form Components",
    description: "Detailed form component documentation with validation and accessibility patterns.",
    image: "/docs-form.jpg",
    imageAlt: "Form Component Documentation",
    borderColor: "purple"
  },
  {
    title: "Badge System",
    description: "Complete badge component documentation with variant examples and usage guidelines.",
    image: "/docs-badge.jpg",
    imageAlt: "Badge Component Documentation",
    borderColor: "yellow"
  },
  {
    title: "Notification System",
    description: "Toast notifications, alerts, and feedback components with timing and positioning options.",
    image: "/docs-notify.jpg",
    imageAlt: "Notification Component Documentation",
    borderColor: "indigo"
  },
  {
    title: "Mobile Responsive",
    description: "Mobile-optimized component examples and responsive design patterns.",
    image: "/mobile-example.jpg",
    imageAlt: "Mobile Documentation Examples",
    borderColor: "red"
  }
];

const processImages = [
  { src: "/dash-example.jpg", alt: "Documentation Dashboard" },
  { src: "/users-example.jpg", alt: "User Documentation Examples" },
  { src: "/audit-example.jpg", alt: "Documentation Audit Process" },
  { src: "/mobile2-example.jpg", alt: "Mobile Documentation Interface" }
];

const benefitGroups = [
  {
    title: "For Developers",
    benefits: [
      { icon: "green", text: "Faster component discovery and implementation" },
      { icon: "green", text: "Live examples reduce integration time" },
      { icon: "green", text: "Always up-to-date documentation" },
      { icon: "green", text: "Multi-framework code examples" }
    ]
  },
  {
    title: "For Design Teams",
    benefits: [
      { icon: "blue", text: "Visual component library overview" },
      { icon: "blue", text: "Design token documentation" },
      { icon: "blue", text: "Usage guidelines and best practices" },
      { icon: "blue", text: "Accessibility documentation" }
    ]
  }
];
---

<PortfolioLayout
  title="Cupcake Documentation Platform - Josh Easter Portfolio"
  description="A comprehensive documentation platform built for design systems, featuring interactive examples and component playgrounds."
  projectTitle="Cupcake Docs"
  projectSubtitle="An interactive documentation platform that brings design systems to life with live examples, component playgrounds, and comprehensive API documentation."
  heroImage="/cupcake-docs.jpg"
  gradientColors="from-green-400 via-blue-400 to-purple-400"
>
  <div slot="hero-content">
    <h3 class="text-2xl font-semibold text-white mb-2">Documentation Platform</h3>
    <p class="text-slate-300">Interactive docs with live component examples</p>
  </div>

  <ProjectDetails
    title="Platform Overview"
    description="Cupcake Docs was created to solve the challenge of maintaining up-to-date, interactive documentation for our design system. It automatically generates documentation from code comments and provides live component examples."
    features={features}
    metrics={metrics}
  >
    <TechStack
      title="Technical Architecture"
      categories={techCategories}
      additionalInfo={[
        "Automated prop extraction from TypeScript",
        "Git-based version control integration",
        "CI/CD pipeline for docs deployment",
        "Automated accessibility testing"
      ]}
    />
  </ProjectDetails>

  <ContentSection title="Documentation Features">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
      {documentationFeatures.map(feature => (
        <FeatureCard
          title={feature.title}
          description={feature.description}
          image={feature.image}
          imageAlt={feature.imageAlt}
          borderColor={feature.borderColor}
        />
      ))}
    </div>

    <div class="mb-16">
      <h2 class="text-3xl font-bold mb-8 text-white">Documentation Process</h2>
      <div class="grid lg:grid-cols-2 gap-12">
        <div>
          <h3 class="text-xl font-semibold text-white mb-4">Automated Documentation</h3>
          <p class="text-slate-300 mb-6 leading-relaxed">
            As we all know "If it isn't documented it didn't happen!". So we needed to document and centralize all of these efforts.
          </p>
          <p class="text-slate-300 mb-6 leading-relaxed">
            We also needed a way to grow the library with larger patterns and page layouts.
          </p>
          <p class="text-slate-300 mb-8 leading-relaxed">
            I built a Jekyll documentation site that also embeds the Angular library via Storybook.
          </p>

          <div class="flex flex-col sm:flex-row gap-4">
            <a href="https://cupcake-design-system.github.io" target="_blank" class="px-6 py-3 bg-gradient-to-r from-green-600 to-blue-600 hover:from-green-700 hover:to-blue-700 rounded-lg text-white font-medium transition-all duration-300 text-center">
              View Live Docs
            </a>
            <a href="/portfolio/cupcake-design-system" class="px-6 py-3 border border-slate-600 hover:border-slate-400 rounded-lg text-slate-300 hover:text-white font-medium transition-all duration-300 text-center">
              View Case Study
            </a>
          </div>
        </div>

        <ImageGallery images={processImages} columns="2" />
      </div>
    </div>

    <div class="text-center">
      <h3 class="text-2xl font-semibold text-white mb-6">Explore the Documentation</h3>
      <div class="grid md:grid-cols-3 gap-6">
        <a href="https://cupcake-design-system.github.io" target="_blank" class="block p-6 bg-slate-800 rounded-xl border border-slate-700 hover:border-green-500 transition-colors group">
          <h4 class="text-white font-semibold mb-2 group-hover:text-green-400">Main Documentation</h4>
          <p class="text-slate-400 text-sm">Complete design system documentation with guidelines and examples</p>
        </a>

        <a href="https://cupcake.netlify.com/index.html" target="_blank" class="block p-6 bg-slate-800 rounded-xl border border-slate-700 hover:border-blue-500 transition-colors group">
          <h4 class="text-white font-semibold mb-2 group-hover:text-blue-400">HTML Documentation</h4>
          <p class="text-slate-400 text-sm">Pure HTML/CSS implementation examples and code snippets</p>
        </a>

        <a href="http://cupcake-sprinkles.surge.sh" target="_blank" class="block p-6 bg-slate-800 rounded-xl border border-slate-700 hover:border-orange-500 transition-colors group">
          <h4 class="text-white font-semibold mb-2 group-hover:text-orange-400">Angular Library</h4>
          <p class="text-slate-400 text-sm">Cupcake Sprinkles Angular component library documentation</p>
        </a>
      </div>
    </div>
  </ContentSection>

  <BenefitsSection 
    title="Platform Benefits"
    benefitGroups={benefitGroups}
  />
</PortfolioLayout>
