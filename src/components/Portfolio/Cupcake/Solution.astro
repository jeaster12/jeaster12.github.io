          {
            icon: 'logos:storybook-icon',
            title: 'Live Components',
            description: 'Embedded Storybook showing interactive examples with real component code'
          }
        ]
      }
    },
    {
      icon: 'line-md:confirm-circle',
      iconColor: 'text-blue-500',
      title: 'Quality & Governance',
      description: 'Implemented comprehensive testing, linting, and visual regression tools to ensure code quality and consistency.',
