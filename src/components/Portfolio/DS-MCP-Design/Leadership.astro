---
import SectionTitle from '@/components/UI/SectionTitle.astro';
import CardHeader from '@/components/UI/CardHeader.astro';
import MetricCard from '@/components/UI/MetricCard.astro';
---

<SectionTitle
  title="Executive & Leadership Engagement"
  description="Regular reporting & executive reviews kept leadership informed of progress & impact, while <strong>quarterly business reviews</strong> solidified alignment & investment. In fact, after our POC demo, we had <strong>more executive stakeholder requests than we could handle</strong>."/>

<div class="grid gap-6 md:grid-cols-2 mb-6">
  <div class="card md:p-6 p-4 shadow-sm">
    <CardHeader
      icon="line-md:arrow-up-circle"
      title="Executive Reporting"
      iconSize={24}
      className="mb-2"
    />
    <div class="space-y-3 text-sm">
      <div class="bg-gray-100 dark:bg-black/40 p-3 rounded-lg">
        <strong>Monthly Dashboards:</strong> Adoption metrics, productivity gains
        <p class="italic text-xs mt-1">Visual reports for leadership team</p>
      </div>
      <div class="bg-gray-100 dark:bg-black/40 p-3 rounded-lg">
        <strong>Quarterly Business Reviews:</strong> ROI analysis, strategic alignment
        <p class="italic text-xs mt-1">$2.3M annual savings demonstration</p>
      </div>
      <div class="bg-gray-100 dark:bg-black/40 p-3 rounded-lg">
        <strong>Success Stories:</strong> Team testimonials and case studies
        <p class="italic text-xs mt-1">Real impact on product delivery</p>
      </div>
    </div>
  </div>

  <div class="card md:p-6 p-4 shadow-sm">
    <CardHeader
      icon="line-md:navigation-right-up"
      iconSize={24}
      className="mb-2"
      title="Strategic Initiatives"
      iconColor="text-purple-600 dark:text-purple-400"
    />
    <div class="space-y-3 text-sm">
      <div class="bg-gray-100 dark:bg-black/40 p-3 rounded-lg">
        <strong>Digital Transformation:</strong> Design system as enabler
        <p class="italic text-xs mt-1">Accelerating product modernization</p>
      </div>
      <div class="bg-gray-100 dark:bg-black/40 p-3 rounded-lg">
        <strong>Accessibility Compliance:</strong> Risk mitigation strategy
        <p class="italic text-xs mt-1">94% WCAG compliance achievement</p>
      </div>
      <div class="bg-gray-100 dark:bg-black/40 p-3 rounded-lg">
        <strong>UX Team Experience:</strong> Talent retention tool
        <p class="italic text-xs mt-1">Improved satisfaction and productivity</p>
      </div>
    </div>
  </div>
</div>

<div class="bg-purple-50 dark:bg-purple-950/40 border border-purple-200 dark:border-purple-900 rounded-lg md:p-6 p-4">
  <CardHeader
    icon="line-md:star-filled"
    iconSize={24}
    className="mb-2"
    title="UX Team Leadership Impact"
    iconColor="text-purple-700 dark:text-purple-300"
  />
  <div class="grid gap-6 md:grid-cols-3 text-sm">
    <MetricCard value="$2.3M" label="Annual productivity savings" />
    <MetricCard value="25%" label="Faster feature delivery" />
    <MetricCard value="60%" label="Reduction in design debt" />
  </div>
</div>
