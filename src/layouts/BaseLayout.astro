---
import '../styles/global.css';
import Header from '@components/Header.astro';
import BGLines from '@components/BGLines.astro';
import Head from '@components/Layout/Head.astro';
import Footer from '@/components/Layout/Footer.astro';
import BackToTop from '@components/UI/BackToTop.astro';

type Props = {
  title?: string;
  ogImage?: string;
  noindex?: boolean;
  description?: string;
}

const { title, description, ogImage, noindex } = Astro.props
---

<!doctype html>
<html class="scroll-smooth" lang="en">
	<Head
    title={title}
    ogImage={ogImage}
    noindex={noindex}
    description={description}
  />

  <style>
    /* View Transitions Animation */
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    /* Progress bar for page transitions */
    #progress-bar {
      position: fixed;
      top: 0;
      left: 0;
      width: 0%;
      height: 3px;
      background: linear-gradient(90deg, #4f46e5, #8b5cf6);
      z-index: 9999;
      transition: width 0.3s ease;
    }

    /* Smooth transitions for view transitions */
    ::view-transition-old(root) {
      animation: 90ms cubic-bezier(0.4, 0, 0.2, 1) both fade-out;
    }

    ::view-transition-new(root) {
      animation: 210ms cubic-bezier(0, 0, 0.2, 1) 90ms both fade-in;
    }

    @keyframes fade-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes fade-out {
      to { opacity: 0; }
    }
  </style>

	<body class="overflow-x-hidden bg-bodyBg font-opensans dark:bg-black">
    <!-- Progress bar for page transitions -->
    <div id="progress-bar"></div>

    <!-- View Transitions API -->
    <script>
      // Progress bar animation
      document.addEventListener('astro:before-preparation', () => {
        const progressBar = document.getElementById('progress-bar');
        if (progressBar) {
          progressBar.style.width = '70%';
        }
      });

      document.addEventListener('astro:after-swap', () => {
        const progressBar = document.getElementById('progress-bar');
        if (progressBar) {
          progressBar.style.width = '100%';
          setTimeout(() => {
            progressBar.style.transition = 'width 0.1s ease-out';
            progressBar.style.width = '0%';
          }, 100);
        }
      });

      // Fallback for browsers that don't support View Transitions
      if (!document.startViewTransition) {
        console.warn('View Transitions API not supported in this browser');
      } else {
        // Smooth scroll to top on page navigation
        document.addEventListener('astro:page-load', () => {
          window.scrollTo(0, 0);
        });
      }
    </script>

		<div class="container max-w-[1320px] mx-auto px-5 xl:px-3">
			<Header />
			<slot />
		</div>

		<BGLines />

		<Footer />
		<BackToTop />
		<script is:inline defer src="/assets/js/functions.js"></script>
	</body>
</html>
