        </div>
        <div>
          <label>Query</label>
          <input readonly="" class="w-full mt-2 rounded-md border border-global dark:bg-black/40 px-3 py-2 outline-none" value="Buttons in loading state must preserve focus, announce status, and prevent duplicate submits." />
        </div>
