---
const developerQuotes = [
  {
    quote: '"The MCP Server is like having a senior developer looking over my shoulder, but without the judgment. It catches issues I didn\'t even know existed."',
    author: 'Frontend Developer, 6 months experience',
    borderColor: 'border-primary-400'
  },
  {
    quote: '"I used to spend 20 minutes per PR in code review just explaining design token usage. Now the MCP Server handles that education automatically."',
    author: 'Tech Lead, Design Systems',
    borderColor: 'border-blue-400'
  },
  {
    quote: '"The contextual suggestions are incredible. Instead of just saying \'fix this color,\' it shows me exactly which token to use and why."',
    author: 'Senior Engineer, Accessibility Team',
    borderColor: 'border-green-400'
  }
];
---

<div class="card p-6 shadow-sm mb-6">
  <h3 class="font-semibold text-xl mb-4 flex items-center">
    Developer Feedback
  </h3>
  <div class="space-y-4 text-sm pl-2.5">
    {developerQuotes.map((quote) => (
      <div class={`border-l-4 ${quote.borderColor} pl-4`}>
        <p class="italic">{quote.quote}</p>
        <p class="text-xs text-gray-500 mt-1">- {quote.author}</p>
      </div>
    ))}
  </div>
</div>