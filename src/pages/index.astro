              </svg>
            </a>
            <a href="mailto:jeaster12@gmail.com" class="text-slate-400 hover:text-blue-400 transition-colors">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819L11.18 14.71c-.316-.316-.883-.316-1.2 0L2.454 21.002H1.636C.732 21.002 0 20.27 0 19.366V5.457c0-.904.732-1.636 1.636-1.636h20.728c.904 0 1.636.732 1.636 1.636z"/>
              </svg>
            </a>
          </div>
        </div>
      </section>

      <!-- About Section -->
      <section id="about" class="py-20 bg-slate-800">
        <div class="max-w-6xl mx-auto px-6">
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div>
              <h2 class="text-4xl font-bold mb-6 text-white">About Me</h2>
              <p class="text-slate-300 text-lg mb-6 leading-relaxed">
                Experienced UX Director leading enterprise-level design and development initiatives across complex platforms and tools. Passionate about human-centered design, scalable UX/UI architecture, and cross-functional leadership.
              </p>
              <p class="text-slate-300 mb-8 leading-relaxed">
                Proven success in improving usability, performance, and design consistency across digital products.
              </p>
              
              <div class="space-y-4 mb-8">
                <h3 class="text-xl font-semibold text-white">A Few Things About Me</h3>
                <ul class="space-y-2 text-slate-300">
                  <li class="flex items-start">
                    <span class="text-blue-400 mr-2">•</span>
                    Father & Husband. Always learning. Can't grow a beard.
                  </li>
                  <li class="flex items-start">
                    <span class="text-blue-400 mr-2">•</span>
                    Musician & Occasional Audio Engineer.
                  </li>
                  <li class="flex items-start">
                    <span class="text-blue-400 mr-2">��</span>
                    Lover of Coffee & Wine
                  </li>
                  <li class="flex items-start">
                    <span class="text-blue-400 mr-2">•</span>
                    Total tech geek. Never far away from an Apple product.
                  </li>
                  <li class="flex items-start">
                    <span class="text-blue-400 mr-2">•</span>
                    I love most sports but I am a huge baseball fan. GO RED SOX!
                  </li>
                </ul>
              </div>

              <div class="flex flex-col sm:flex-row gap-4">
                <a href="/resume.pdf" class="px-6 py-3 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 rounded-lg text-white font-medium transition-all duration-300 text-center">
                  Download Resume
                </a>
                <a href="#contact" class="px-6 py-3 border border-slate-600 hover:border-slate-400 rounded-lg text-slate-300 hover:text-white font-medium transition-all duration-300 text-center">
                  Get in Touch
                </a>
              </div>
            </div>
            
            <div class="relative">
              <div class="relative z-10 rounded-2xl overflow-hidden shadow-2xl">
                <img src="/josh-profile.jpg" alt="Josh Easter" class="w-full h-auto object-cover" />
              </div>
              <div class="absolute -inset-4 bg-gradient-to-r from-blue-600/20 to-purple-600/20 rounded-3xl -z-10"></div>
            </div>
          </div>
        </div>
      </section>

      <!-- Skills Section -->
      <section id="skills" class="py-20 bg-slate-900">
        <div class="max-w-6xl mx-auto px-6">
          <div class="text-center mb-16">
            <h2 class="text-4xl font-bold mb-6 text-white">Skills & Technologies</h2>
            <p class="text-slate-300 text-lg max-w-3xl mx-auto leading-relaxed">
              I am a hybrid design engineer with talent for creating elegant user interfaces, instinctive user experiences, and expertly crafted code. I focus on building scalable design systems and leading multifunctional teams.
            </p>
          </div>

          <div class="grid md:grid-cols-3 gap-8">
            <!-- Design & Development Tools -->
            <div class="bg-slate-800 rounded-xl p-8 border border-slate-700">
              <div class="mb-6">
                <h3 class="text-xl font-semibold text-white mb-4">Design & Development</h3>
                <div class="grid grid-cols-4 gap-4">
                  <!-- Figma -->
                  <div class="flex justify-center" title="Figma">
