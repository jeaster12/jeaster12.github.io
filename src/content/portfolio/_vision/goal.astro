---
import { Icon } from 'astro-icon/components';
--- 
 
<div class="card-gray shadow-sm rounded-lg md:p-6 p-4 mb-8">
  <div class="flex items-start gap-4">
    <Icon name="line-md:star-filled" class="w-8 h-8 text-purple-500 dark:text-purple-400 flex-shrink-0" />
    <div>
      <h3 class="font-bold text-xl mb-2">The Strategic Goal</h3>
      <p class="text-base mb-3">
        Build an <strong>AI-powered orchestration layer</strong> that unifies existing development tools with design system intelligence. This system should provide instant, trustworthy feedback that shifts quality left; catching <strong>85%+ of issues before commit</strong> while maintaining <strong>sub-10 second feedback times</strong>.
      </p>
      <div class="grid md:grid-cols-3 gap-4 mt-4">
        <div class="card-white rounded-lg p-4">
          <div class="text-2xl font-bold text-purple-600 dark:text-purple-400">90%+</div>
          <div class="text-xs text-gray-600 dark:text-gray-400">Developer Adoption Target</div>
        </div>
        <div class="card-white rounded-lg p-4">
          <div class="text-2xl font-bold text-purple-600 dark:text-purple-400">85%+</div>
          <div class="text-xs text-gray-600 dark:text-gray-400">Issues Caught Pre-Commit</div>
        </div>
        <div class="card-white rounded-lg p-4">
          <div class="text-2xl font-bold text-purple-600 dark:text-purple-400">&lt;10s</div>
          <div class="text-xs text-gray-600 dark:text-gray-400">Feedback Time Target</div>
        </div>
      </div>
    </div>
  </div>
</div>