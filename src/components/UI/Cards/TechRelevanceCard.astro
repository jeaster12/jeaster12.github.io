---
import { Icon } from 'astro-icon/components';
---

<div class="purple-gradient rounded-lg p-4 md:p-6">
  <div class="flex items-center gap-3 mb-4">
    <div class="flex-shrink-0">
      <div class="w-10 h-10 rounded-full bg-purple-600/10 flex items-center justify-center">
        <Icon name="line-md:cog-loop" class="text-purple-600 text-xl" />
      </div>
    </div>
    <div>
      <h3 class="text-xl font-bold mb-0 text-gray-900 dark:text-white">Platform Engineering at Scale</h3>
      <p class="text-sm text-gray-600 dark:text-gray-400">
        Production-grade infrastructure that scales from prototype to thousands of users—real-world platform engineering experience.
      </p>
    </div>
  </div>

  <div class="grid md:grid-cols-3 gap-4 mb-4">
    <div class="bg-white/50 dark:bg-black/20 rounded-lg p-4">
      <div class="flex items-center gap-2 mb-2">
        <Icon name="line-md:speedometer-loop" class="text-purple-600 text-xl flex-shrink-0" />
        <h4 class="font-semibold text-sm text-gray- mb-0">Enterprise Scale</h4>
      </div>
      <div class="text-xs text-gray-600 dark:text-gray-400 space-y-1">
        <div>1000+ developers • &lt;200ms P95</div>
        <div>99.9% uptime • 10K queries/day</div>
      </div>
    </div>

    <div class="bg-white/50 dark:bg-black/20 rounded-lg p-4">
      <div class="flex items-center gap-2 mb-2">
        <Icon name="line-md:cog-loop" class="text-purple-600 text-xl flex-shrink-0" />
        <h4 class="font-semibold text-sm text-gray-900 dark:text-white mb-0">Platform Thinking</h4>
      </div>
      <div class="text-xs text-gray-600 dark:text-gray-400 space-y-1">
        <div>MCP protocol • Extensible APIs</div>
        <div>Multi-client • Event-driven</div>
      </div>
    </div>

    <div class="bg-white/50 dark:bg-black/20 rounded-lg p-4">
      <div class="flex items-center gap-2 mb-2">
        <Icon name="line-md:gauge-loop" class="text-purple-600 text-xl flex-shrink-0" />
        <h4 class="font-semibold text-sm text-gray-900 dark:text-white mb-0">Production Ready</h4>
      </div>
      <div class="text-xs text-gray-600 dark:text-gray-400 space-y-1">
        <div>Monitoring • Tracing • Alerts</div>
        <div>&lt;0.5% error rate • Cost tracking</div>
      </div>
    </div>
  </div>

  <div class="bg-white/70 dark:bg-black/30 rounded-lg p-4 text-sm">
    <div class="font-semibold text-gray-900 dark:text-white mb-2 flex items-center gap-2">
      <Icon name="line-md:star-filled" class="text-purple-600" />
      Platform Engineering Capabilities
    </div>
    <div class="grid md:grid-cols-3 gap-x-4 gap-y-2 text-xs text-gray-700 dark:text-gray-300">
      <div>✓ Developer-first tools (60% adoption)</div>
      <div>✓ Build vs. buy evaluation</div>
      <div>✓ Cost optimization ($50K → $8K/mo)</div>
      <div>✓ Security & compliance (SOC2)</div>
      <div>✓ Cross-functional execution</div>
      <div>✓ Incremental delivery (PoC to GA)</div>
    </div>
  </div>
</div>
