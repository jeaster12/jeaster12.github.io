---
export interface Props {
  variant?: 'default' | 'bordered' | 'elevated';
  padding?: 'none' | 'sm' | 'md' | 'lg';
  class?: string;
}

const { 
  variant = 'default', 
  padding = 'md',
  class: className = '',
  ...rest 
} = Astro.props;

const baseClasses = 'rounded-xl transition-all duration-300';

const variants = {
  default: 'bg-slate-800',
  bordered: 'bg-slate-800 border border-slate-700 hover:border-slate-600',
  elevated: 'bg-slate-800 border border-slate-700 shadow-xl hover:shadow-2xl'
};

const paddings = {
  none: '',
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8'
};

const classes = `${baseClasses} ${variants[variant]} ${paddings[padding]} ${className}`;
---

<div class={classes} {...rest}>
  <slot />
</div>
