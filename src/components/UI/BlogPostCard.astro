---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'> & { slug: string };
  showDate?: boolean;
}

const {
  post,
  showDate = true,
} = Astro.props as Props;


const formatDate = (date: Date): string => {
  return new Date(date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });
};

// Calculate reading time
const getReadingTime = async () => {
  const { Content } = await post.render();
  const text = Content.toString();
  const wordsPerMinute = 200;
  const wordCount = text.split(/\s+/).length;
  const readingTime = Math.ceil(wordCount / wordsPerMinute);
  return readingTime;
};

const readingTime = await getReadingTime();
---

<article class="relative w-full h-64 group rounded-lg overflow-hidden shadow-lg hover:shadow-2xl transition duration-300 ease-in-out hover:scale-105">

  <Image
    src={post.data.featuredImage.url}
    alt={post.data.title}
    width={800}
    height={400}
    loading="lazy"
    class="absolute inset-0 w-full h-full object-cover"
  />

  <div class="absolute inset-0 bg-black bg-opacity-50 group-hover:opacity-75 transition duration-300 ease-in-out"></div>

  <div class="relative w-full h-full p-6 flex flex-col justify-center items-center">
    
    <a class="text-white text-2xl font-bold text-center mt-auto" href={`/blog/${post.slug}`} aria-label={`Read ${post.data.title}`}>
      <span class="absolute inset-0"></span>
      {post.data.title}
    </a>

    <p class="text-white text-xs font-semibold text-center">{post.data.description}</p>

    {showDate && (
      <dl class="flex gap-4 justify-center mt-auto text-xs text-neutral-400"> 
        <div class="flex items-center gap-2"> 
          <dt> 
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5"> <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"></path> </svg> 
          </dt> 
          <dd>{formatDate(post.data.pubDate)}</dd> 
        </div> 
        <div class="flex items-center gap-2"> 
          <dt>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5"> <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"></path> </svg>
          </dt>
            <dd>{readingTime} {readingTime === 1 ? 'minute' : 'minutes'}</dd> 
        </div> 
      </dl>
    )}

  </div>
  
</article>