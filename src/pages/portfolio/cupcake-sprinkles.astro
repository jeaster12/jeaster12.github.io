---
import '../../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cupcake Sprinkles (Angular) - Josh Easter Portfolio</title>
    <meta name="description" content="A comprehensive Angular component library built on top of the Cupcake Design System, providing enterprise-grade UI components." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-slate-900 text-white font-sans antialiased">
    <!-- Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-slate-900/95 backdrop-blur-sm border-b border-slate-800">
      <div class="max-w-6xl mx-auto px-6 py-4">
        <div class="flex items-center justify-between">
          <a href="/" class="font-bold text-xl text-white hover:text-blue-400 transition-colors">Josh Easter</a>
          <div class="hidden md:flex items-center space-x-8">
            <a href="/#about" class="text-slate-300 hover:text-white transition-colors">About</a>
            <a href="/#experience" class="text-slate-300 hover:text-white transition-colors">Experience</a>
            <a href="/#portfolio" class="text-slate-300 hover:text-white transition-colors">Portfolio</a>
            <a href="/#contact" class="text-slate-300 hover:text-white transition-colors">Contact</a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="pt-24 pb-16 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-12">
          <h1 class="text-5xl md:text-6xl font-bold mb-6 bg-gradient-to-r from-orange-400 via-red-400 to-pink-400 bg-clip-text text-transparent">
            Cupcake Sprinkles
          </h1>
          <p class="text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed">
            A comprehensive Angular component library that brings the Cupcake Design System to Angular applications with TypeScript support and enterprise-grade features.
          </p>
        </div>
        
        <div class="relative rounded-2xl overflow-hidden shadow-2xl mb-12">
          <div class="aspect-video relative">
            <img src="/sprinkles.jpg" alt="Cupcake Sprinkles Angular Components Interface" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/40 to-transparent"></div>
            <div class="absolute bottom-8 left-8 right-8 text-center">
              <h3 class="text-2xl font-semibold text-white mb-2">Angular Components</h3>
              <p class="text-slate-300">Enterprise-ready Angular component library</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Project Details -->
    <section class="py-20 bg-slate-800">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-12">
          <!-- Project Info -->
          <div>
            <h2 class="text-3xl font-bold mb-6 text-white">Library Overview</h2>
            <p class="text-slate-300 mb-6 leading-relaxed">
              Cupcake Sprinkles provides Angular developers with a complete set of production-ready components that follow Angular best practices and integrate seamlessly with the broader Cupcake Design System ecosystem.
            </p>
            
            <div class="space-y-6">
              <div>
                <h3 class="text-xl font-semibold text-white mb-3">Component Features</h3>
                <ul class="space-y-3 text-slate-300">
                  <li class="flex items-start">
                    <span class="text-orange-400 mr-2 mt-1.5 w-2 h-2 rounded-full bg-orange-400 flex-shrink-0"></span>
                    75+ Angular components and directives
                  </li>
                  <li class="flex items-start">
                    <span class="text-orange-400 mr-2 mt-1.5 w-2 h-2 rounded-full bg-orange-400 flex-shrink-0"></span>
                    Full TypeScript support with strict typing
                  </li>
                  <li class="flex items-start">
                    <span class="text-orange-400 mr-2 mt-1.5 w-2 h-2 rounded-full bg-orange-400 flex-shrink-0"></span>
                    Reactive forms integration
                  </li>
                  <li class="flex items-start">
                    <span class="text-orange-400 mr-2 mt-1.5 w-2 h-2 rounded-full bg-orange-400 flex-shrink-0"></span>
                    Angular CDK integration for accessibility
                  </li>
                  <li class="flex items-start">
                    <span class="text-orange-400 mr-2 mt-1.5 w-2 h-2 rounded-full bg-orange-400 flex-shrink-0"></span>
                    Tree-shakeable modular architecture
                  </li>
                  <li class="flex items-start">
                    <span class="text-orange-400 mr-2 mt-1.5 w-2 h-2 rounded-full bg-orange-400 flex-shrink-0"></span>
                    OnPush change detection strategy
                  </li>
                </ul>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-white mb-3">Enterprise Features</h3>
                <ul class="space-y-3 text-slate-300">
                  <li class="flex items-start">
                    <span class="text-red-400 mr-2 mt-1.5 w-2 h-2 rounded-full bg-red-400 flex-shrink-0"></span>
                    Angular Universal SSR support
                  </li>
                  <li class="flex items-start">
                    <span class="text-red-400 mr-2 mt-1.5 w-2 h-2 rounded-full bg-red-400 flex-shrink-0"></span>
                    Internationalization (i18n) ready
                  </li>
                  <li class="flex items-start">
                    <span class="text-red-400 mr-2 mt-1.5 w-2 h-2 rounded-full bg-red-400 flex-shrink-0"></span>
                    Performance optimized with OnPush
                  </li>
                  <li class="flex items-start">
                    <span class="text-red-400 mr-2 mt-1.5 w-2 h-2 rounded-full bg-red-400 flex-shrink-0"></span>
                    Comprehensive test coverage
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Installation & Usage -->
          <div>
            <h2 class="text-3xl font-bold mb-6 text-white">Installation & Usage</h2>
            
            <div class="space-y-6">
              <div class="bg-slate-900 rounded-xl p-6 border border-slate-700">
                <h3 class="text-lg font-semibold text-white mb-4">Quick Start</h3>
                <div class="bg-black rounded-lg p-4 font-mono text-sm">
                  <div class="text-gray-400 mb-2"># Install the package</div>
                  <div class="text-green-400">npm install @cupcake/sprinkles</div>
                  <div class="text-gray-400 mt-4 mb-2"># Import in your module</div>
                  <div class="text-blue-400">import &#123; CupcakeModule &#125; from</div>
                  <div class="text-green-400 ml-4">'@cupcake/sprinkles';</div>
                </div>
              </div>

              <div class="bg-slate-900 rounded-xl p-6 border border-slate-700">
                <h3 class="text-lg font-semibold text-white mb-4">Component Example</h3>
                <div class="bg-black rounded-lg p-4 font-mono text-sm">
                  <div class="text-blue-400">&lt;cup-button</div>
                  <div class="text-yellow-400 ml-4">variant="primary"</div>
                  <div class="text-yellow-400 ml-4">size="large"</div>
                  <div class="text-yellow-400 ml-4">[disabled]="isLoading"</div>
                  <div class="text-yellow-400 ml-4">(click)="handleClick()"</div>
                  <div class="text-blue-400">&gt;</div>
                  <div class="text-white ml-4">&#123;&#123; buttonText &#125;&#125;</div>
                  <div class="text-blue-400">&lt;/cup-button&gt;</div>
                </div>
              </div>

              <div class="bg-slate-900 rounded-xl p-6 border border-slate-700">
                <h3 class="text-lg font-semibold text-white mb-4">Angular Versions</h3>
                <div class="grid grid-cols-2 gap-4">
                  <div class="text-center">
                    <div class="w-12 h-12 mx-auto mb-2 bg-gradient-to-r from-red-600 to-pink-600 rounded-lg flex items-center justify-center">
                      <span class="text-xs font-bold text-white">17+</span>
                    </div>
                    <p class="text-sm text-slate-300">Angular 17+</p>
                  </div>
                  <div class="text-center">
                    <div class="w-12 h-12 mx-auto mb-2 bg-gradient-to-r from-orange-500 to-red-500 rounded-lg flex items-center justify-center">
                      <span class="text-xs font-bold text-white">LTS</span>
                    </div>
                    <p class="text-sm text-slate-300">LTS Support</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Component Showcase -->
    <section class="py-20 bg-slate-900">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-3xl font-bold mb-12 text-center text-white">Angular Component Gallery</h2>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
          <!-- Form Components -->
          <div class="bg-slate-800 rounded-xl p-6 border border-slate-700 hover:border-orange-500 transition-colors">
            <div class="aspect-video rounded-lg mb-4 overflow-hidden">
              <img src="/storybookForm.jpg" alt="Angular Form Components" class="w-full h-full object-cover" />
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Form Components</h3>
            <p class="text-slate-400 text-sm">Input, Select, Checkbox, Radio, DatePicker with Angular Reactive Forms integration.</p>
          </div>

          <!-- Date Components -->
          <div class="bg-slate-800 rounded-xl p-6 border border-slate-700 hover:border-red-500 transition-colors">
            <div class="aspect-video rounded-lg mb-4 overflow-hidden">
              <img src="/storybookDate.jpg" alt="Angular Date Components" class="w-full h-full object-cover" />
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Date Components</h3>
            <p class="text-slate-400 text-sm">Date picker, time picker, and calendar components with internationalization support.</p>
          </div>

          <!-- Advanced Forms -->
          <div class="bg-slate-800 rounded-xl p-6 border border-slate-700 hover:border-yellow-500 transition-colors">
            <div class="aspect-video rounded-lg mb-4 overflow-hidden">
              <img src="/sprinklesForm.jpg" alt="Angular Form Layout" class="w-full h-full object-cover" />
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Form Layouts</h3>
            <p class="text-slate-400 text-sm">Advanced form layouts with validation, error handling, and responsive design patterns.</p>
          </div>

          <!-- Avatar Components -->
          <div class="bg-slate-800 rounded-xl p-6 border border-slate-700 hover:border-green-500 transition-colors">
            <div class="aspect-video rounded-lg mb-4 overflow-hidden">
              <img src="/avatar.jpg" alt="Avatar Angular Components" class="w-full h-full object-cover" />
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Avatar System</h3>
            <p class="text-slate-400 text-sm">Flexible avatar components with image fallbacks and custom initial generation.</p>
          </div>

          <!-- Badge Components -->
          <div class="bg-slate-800 rounded-xl p-6 border border-slate-700 hover:border-blue-500 transition-colors">
            <div class="aspect-video rounded-lg mb-4 overflow-hidden">
              <img src="/badge.jpg" alt="Badge Angular Components" class="w-full h-full object-cover" />
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Badge System</h3>
            <p class="text-slate-400 text-sm">Status badges, notification indicators, and labeling components with theming support.</p>
          </div>

          <!-- Layout Components -->
          <div class="bg-slate-800 rounded-xl p-6 border border-slate-700 hover:border-purple-500 transition-colors">
            <div class="aspect-video rounded-lg mb-4 overflow-hidden">
              <img src="/layout.jpg" alt="Layout Angular Components" class="w-full h-full object-cover" />
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Layout System</h3>
            <p class="text-slate-400 text-sm">Grid, Flex, Container, and responsive layout components for Angular applications.</p>
          </div>
        </div>

        <!-- Angular Development Process -->
        <div class="mb-16">
          <h2 class="text-3xl font-bold mb-8 text-white">Angular Development Process</h2>
          <div class="grid lg:grid-cols-2 gap-12">
            <div>
              <h3 class="text-xl font-semibold text-white mb-4">Building Sprinkles</h3>
              <p class="text-slate-300 mb-6 leading-relaxed">
                While design decisions were being made and adopted, I started my team's sprints building out the core code.
                We first built the HTML/SCSS core, and then began working on an Angular library.
              </p>
              <p class="text-slate-300 mb-6 leading-relaxed">
                We affectionately named it "Sprinkles" - because duh. The Angular library provides enterprise-ready components
                with full TypeScript support and Angular best practices.
              </p>
              <p class="text-slate-300 mb-8 leading-relaxed">
                All components are built with OnPush change detection, full accessibility support, and comprehensive testing coverage.
              </p>

              <div class="flex flex-col sm:flex-row gap-4">
                <a href="http://cupcake-sprinkles.surge.sh" target="_blank" class="px-6 py-3 bg-gradient-to-r from-orange-600 to-red-600 hover:from-orange-700 hover:to-red-700 rounded-lg text-white font-medium transition-all duration-300 text-center">
                  View Live Sprinkles
                </a>
                <a href="/portfolio/cupcake-design-system" class="px-6 py-3 border border-slate-600 hover:border-slate-400 rounded-lg text-slate-300 hover:text-white font-medium transition-all duration-300 text-center">
                  View Design System
                </a>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div class="rounded-lg overflow-hidden">
                <img src="/test.png" alt="Angular Testing Process" class="w-full h-full object-cover" />
              </div>
              <div class="rounded-lg overflow-hidden">
                <img src="/quality.jpg" alt="Code Quality Tools" class="w-full h-full object-cover" />
              </div>
              <div class="rounded-lg overflow-hidden">
                <img src="/cc-screen1.jpg" alt="Component Development" class="w-full h-full object-cover" />
              </div>
              <div class="rounded-lg overflow-hidden">
                <img src="/a.jpg" alt="Angular Architecture" class="w-full h-full object-cover" />
              </div>
            </div>
          </div>
        </div>

        <!-- Live Component Examples -->
        <div>
          <h3 class="text-2xl font-semibold text-white mb-8 text-center">Live Component Examples</h3>
          <p class="text-slate-300 text-center mb-12 leading-relaxed">
            All Sprinkles components are built with Angular best practices and include comprehensive Storybook documentation.
          </p>

          <div class="grid md:grid-cols-2 gap-8">
            <div class="rounded-xl overflow-hidden">
              <img src="/example-a.png" alt="Live Angular Component Example A" class="w-full h-auto object-cover" />
            </div>
            <div class="rounded-xl overflow-hidden">
              <img src="/example-f.jpg" alt="Live Angular Component Example F" class="w-full h-auto object-cover" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Technical Features -->
    <section class="py-20 bg-slate-800">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-3xl font-bold mb-12 text-center text-white">Technical Features</h2>
        
        <div class="grid md:grid-cols-2 gap-12">
          <div>
            <h3 class="text-2xl font-semibold text-white mb-6">Angular Integration</h3>
            <div class="space-y-4">
              <div class="bg-slate-900 rounded-lg p-4 border border-slate-700">
                <h4 class="text-lg font-semibold text-white mb-2">Reactive Forms</h4>
                <p class="text-slate-300 text-sm">Full integration with Angular Reactive Forms including custom validators and form controls.</p>
              </div>
              <div class="bg-slate-900 rounded-lg p-4 border border-slate-700">
                <h4 class="text-lg font-semibold text-white mb-2">Change Detection</h4>
                <p class="text-slate-300 text-sm">Optimized with OnPush strategy for maximum performance in large applications.</p>
              </div>
              <div class="bg-slate-900 rounded-lg p-4 border border-slate-700">
                <h4 class="text-lg font-semibold text-white mb-2">Dependency Injection</h4>
                <p class="text-slate-300 text-sm">Leverages Angular's DI system for services and configuration providers.</p>
              </div>
            </div>
          </div>
          
          <div>
            <h3 class="text-2xl font-semibold text-white mb-6">Developer Experience</h3>
            <div class="space-y-4">
              <div class="bg-slate-900 rounded-lg p-4 border border-slate-700">
                <h4 class="text-lg font-semibold text-white mb-2">TypeScript First</h4>
                <p class="text-slate-300 text-sm">Built with TypeScript from the ground up with comprehensive type definitions.</p>
              </div>
              <div class="bg-slate-900 rounded-lg p-4 border border-slate-700">
                <h4 class="text-lg font-semibold text-white mb-2">Angular Schematics</h4>
                <p class="text-slate-300 text-sm">CLI schematics for generating components and setting up the library.</p>
              </div>
              <div class="bg-slate-900 rounded-lg p-4 border border-slate-700">
                <h4 class="text-lg font-semibold text-white mb-2">Testing Utilities</h4>
                <p class="text-slate-300 text-sm">Comprehensive testing utilities and mocks for unit and integration tests.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats & Metrics -->
    <section class="py-20 bg-slate-900">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-3xl font-bold mb-12 text-center text-white">Library Metrics</h2>
        
        <div class="grid md:grid-cols-4 gap-8">
          <div class="text-center">
            <div class="w-20 h-20 mx-auto mb-4 bg-gradient-to-r from-orange-500 to-red-500 rounded-full flex items-center justify-center">
              <span class="text-2xl font-bold text-white">75+</span>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Components</h3>
            <p class="text-slate-400 text-sm">Production-ready Angular components</p>
          </div>
          
          <div class="text-center">
            <div class="w-20 h-20 mx-auto mb-4 bg-gradient-to-r from-blue-500 to-purple-500 rounded-full flex items-center justify-center">
              <span class="text-2xl font-bold text-white">98%</span>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Test Coverage</h3>
            <p class="text-slate-400 text-sm">Comprehensive unit and integration tests</p>
          </div>
          
          <div class="text-center">
            <div class="w-20 h-20 mx-auto mb-4 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full flex items-center justify-center">
              <span class="text-2xl font-bold text-white">15+</span>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Apps Using</h3>
            <p class="text-slate-400 text-sm">Enterprise applications in production</p>
          </div>
          
          <div class="text-center">
            <div class="w-20 h-20 mx-auto mb-4 bg-gradient-to-r from-yellow-500 to-orange-500 rounded-full flex items-center justify-center">
              <span class="text-2xl font-bold text-white">AAA</span>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Accessibility</h3>
            <p class="text-slate-400 text-sm">WCAG 2.1 AA compliant components</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Back to Portfolio -->
    <section class="py-16 bg-slate-800">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/#portfolio" class="px-8 py-3 bg-gradient-to-r from-orange-600 to-red-600 hover:from-orange-700 hover:to-red-700 rounded-full text-white font-medium transition-all duration-300">
            ← Back to Portfolio
          </a>
          <a href="/#contact" class="px-8 py-3 border border-slate-600 hover:border-slate-400 rounded-full text-slate-300 hover:text-white font-medium transition-all duration-300">
            Get in Touch
          </a>
        </div>
      </div>
    </section>
  </body>
</html>
