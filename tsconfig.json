{
  "extends": "astro/tsconfigs/strict",
  "include": ["src/**/*", "src/types/*.d.ts", ".astro/types.d.ts", "**/*"],
  "compilerOptions": {
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@assets/*": ["src/assets/*"],
      "@data/*": ["src/data/*"],
      "@layouts/*": ["src/layouts/*"],
      "@pages/*": ["src/pages/*"],
      "@utils/*": ["src/utils/*"]
    }
  },
  "exclude": ["dist"]
}
