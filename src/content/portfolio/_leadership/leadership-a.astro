<SectionTitle
  width="wide"
  title="Engineering Leadership & Team Development"
  description="Building and leading a cross-functional team to deliver platform infrastructure that scaled across the organization."/>

<div class="grid lg:grid-cols-2 gap-6 mb-8">
  <TeamStructureCard />
  <TeamGrowthCard />
</div>

<!-- Leadership Approach -->
<ManagementPhilosophyCard />

<!-- Managing Senior/Staff Engineers -->
<ManagingSeniorEngineersCard />
  