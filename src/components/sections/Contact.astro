---
import Button from '../ui/Button.astro';
import IconButton from '../ui/IconButton.astro';
---

<section id="contact" class="py-20 bg-slate-800">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-6 text-white">Let's Work Together</h2>
      <p class="text-slate-300 text-lg max-w-3xl mx-auto leading-relaxed">
        I'm always interested in discussing new opportunities, collaborating on innovative projects, 
        or sharing insights about design systems and engineering leadership.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Contact Info -->
      <div>
        <h3 class="text-2xl font-semibold text-white mb-8">Get In Touch</h3>
        
        <div class="space-y-6">
          <!-- Email -->
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-gradient-to-r from-blue-500 to-purple-500 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <p class="text-white font-medium">Email</p>
              <a href="mailto:josh@josheaster.com" class="text-slate-300 hover:text-blue-400 transition-colors">
                josh@josheaster.com
              </a>
            </div>
          </div>

          <!-- LinkedIn -->
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-gradient-to-r from-blue-600 to-cyan-500 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </div>
            <div>
              <p class="text-white font-medium">LinkedIn</p>
              <a href="https://www.linkedin.com/in/josheaster" target="_blank" class="text-slate-300 hover:text-blue-400 transition-colors">
                linkedin.com/in/josheaster
              </a>
            </div>
          </div>

          <!-- Location -->
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-gradient-to-r from-green-500 to-emerald-500 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-white font-medium">Location</p>
              <p class="text-slate-300">Remote / United States</p>
            </div>
          </div>
        </div>

        <!-- Social Links -->
        <div class="mt-12">
          <h4 class="text-lg font-semibold text-white mb-6">Connect With Me</h4>
          <div class="flex gap-4">
            <IconButton 
              icon="lucide:linkedin" 
              href="https://www.linkedin.com/in/josheaster" 
              target="_blank"
              variant="outline"
              size="sm"
            >
              LinkedIn
            </IconButton>
            <IconButton 
              icon="lucide:file-text" 
              href="/resume.pdf"
              target="_blank"
              variant="outline"
              size="sm"
            >
              Resume
            </IconButton>
          </div>
        </div>
      </div>

      <!-- CTA Card -->
      <div class="bg-slate-900 rounded-xl p-8 border border-slate-700">
        <div class="text-center">
          <div class="w-16 h-16 bg-gradient-to-r from-blue-500 to-purple-500 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
          </div>
          
          <h3 class="text-2xl font-semibold text-white mb-4">Ready to Start a Project?</h3>
          <p class="text-slate-300 mb-8 leading-relaxed">
            Whether you're looking to build a design system, improve user experience, 
            or need engineering leadership for your team, I'd love to discuss how we can work together.
          </p>
          
          <div class="space-y-4">
            <Button href="mailto:josh@josheaster.com" variant="primary" size="lg" class="w-full">
              Send Me an Email
            </Button>
            <p class="text-slate-400 text-sm">
              I typically respond within 24 hours
            </p>
          </div>
        </div>

        <!-- Quick Stats -->
        <div class="grid grid-cols-3 gap-4 mt-8 pt-8 border-t border-slate-700">
          <div class="text-center">
            <div class="text-2xl font-bold text-blue-400 mb-1">8+</div>
            <div class="text-slate-400 text-xs">Years Experience</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-purple-400 mb-1">80+</div>
            <div class="text-slate-400 text-xs">Apps Built</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-pink-400 mb-1">150+</div>
            <div class="text-slate-400 text-xs">Components</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Additional Resources -->
    <div class="mt-16 text-center">
      <h3 class="text-xl font-semibold text-white mb-8">Explore My Work</h3>
      <div class="grid md:grid-cols-3 gap-6">
        <a href="/portfolio/cupcake-design-system" class="block p-6 bg-slate-900 rounded-xl border border-slate-700 hover:border-slate-600 transition-colors group">
          <h4 class="text-white font-semibold mb-2 group-hover:text-blue-400">Design System Case Study</h4>
          <p class="text-slate-400 text-sm">Deep dive into building enterprise design systems</p>
        </a>
        
        <a href="https://cupcake-design-system.github.io" target="_blank" class="block p-6 bg-slate-900 rounded-xl border border-slate-700 hover:border-slate-600 transition-colors group">
          <h4 class="text-white font-semibold mb-2 group-hover:text-green-400">Live Documentation</h4>
          <p class="text-slate-400 text-sm">View my profile</p>
        </a>
        
        <a href="/resume.pdf" target="_blank" class="block p-6 bg-slate-900 rounded-xl border border-slate-700 hover:border-slate-600 transition-colors group">
          <h4 class="text-white font-semibold mb-2 group-hover:text-purple-400">Download Resume</h4>
          <p class="text-slate-400 text-sm">Complete professional background and experience</p>
        </a>
      </div>
    </div>
  </div>
</section>
