---
import { Icon } from 'astro-icon/components';
---

<!-- Team Growth & Development -->
<div class="card-green">
  <h3 class="font-bold text-gray-900 mb-2 flex items-center gap-2 dark:text-gray-200">
    <Icon name="line-md:navigation-right-up" class="text-green-600 text-xl dark:text-green-600" />
    Team Growth Impact
  </h3>

  <div class="space-y-4">
    <div class="bg-white/70 rounded-lg p-4 dark:bg-black/20">
      <h4 class="font-semibold text-gray-900 mb-2 dark:text-gray-200">Engineer Promotions (18 months)</h4>
      <div class="space-y-2 text-sm dark:text-gray-400">
        <div class="flex items-start gap-2">
          <Icon name="line-md:star-filled" class="text-amber-500 mt-1 flex-shrink-0 text-xs" />
          <span><strong>Junior → Mid-level (1):</strong> Shipped VS Code extension independently, demonstrated system thinking</span>
        </div>
        <div class="flex items-start gap-2">
          <Icon name="line-md:star-filled" class="text-amber-500 mt-1 flex-shrink-0 text-xs" />
          <span><strong>Mid → Senior (2):</strong> Led cross-team initiatives, mentored others, drove architectural decisions</span>
        </div>
        <div class="flex items-start gap-2">
          <Icon name="line-md:star-filled" class="text-amber-500 mt-1 flex-shrink-0 text-xs" />
          <span><strong>Senior → Staff (1):</strong> Defined multi-quarter technical strategy, led platform architecture</span>
        </div>
      </div>
    </div>

    <div class="bg-white/70 rounded-lg p-4 dark:bg-black/20">
      <div class="text-sm text-gray-700 flex items-center dark:text-gray-400">
        <span class="font-bold text-green-700 text-2xl dark:text-green-700">100%</span>
        <span class="text-gray-800 ml-2 dark:text-gray-400">team retention over project lifecycle</span>
      </div>
    </div>
  </div>
</div>