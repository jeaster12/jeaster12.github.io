---
import { Icon } from 'astro-icon/components';

export interface Props {
  icon: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  target?: '_blank' | '_self';
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
  iconClass?: string;
}

const { 
  icon,
  variant = 'primary', 
  size = 'md', 
  href, 
  target = '_self',
  type = 'button',
  disabled = false,
  class: className = '',
  iconClass = '',
  ...rest 
} = Astro.props;

const baseClasses = 'inline-flex items-center justify-center font-medium transition-all duration-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-slate-900 disabled:opacity-50 disabled:cursor-not-allowed gap-2';

const variants = {
  primary: 'bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white focus:ring-blue-500',
  secondary: 'bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white focus:ring-purple-500',
  outline: 'border border-slate-600 hover:border-slate-400 text-slate-300 hover:text-white hover:bg-slate-800 focus:ring-slate-500',
  ghost: 'text-slate-300 hover:text-white hover:bg-slate-800 focus:ring-slate-500'
};

const sizes = {
  sm: 'px-3 py-2 text-sm',
  md: 'px-4 py-3 text-base',
  lg: 'px-6 py-4 text-lg'
};

const iconSizes = {
  sm: 'w-4 h-4',
  md: 'w-5 h-5',
  lg: 'w-6 h-6'
};

const classes = `${baseClasses} ${variants[variant]} ${sizes[size]} ${className}`;
const iconClassNames = `${iconSizes[size]} ${iconClass}`;

const Element = href ? 'a' : 'button';
---

<Element 
  class={classes}
  href={href}
  target={href && target}
  type={!href ? type : undefined}
  disabled={!href ? disabled : undefined}
  {...rest}
>
  <Icon name={icon} class={iconClassNames} />
  <slot />
</Element>
