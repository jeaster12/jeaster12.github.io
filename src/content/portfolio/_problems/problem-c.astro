---
import { Icon } from 'astro-icon/components'
---

<div class="bg-gray-900 text-white p-8 rounded-lg">
  <h3 class="text-lg font-bold mb-4 flex items-center gap-3 text-white">
    <Icon name="line-md:alert" class="w-6 h-6 text-red-400" />
    Why This Mattered
  </h3>
  <div class="grid md:grid-cols-2 gap-4 text-sm">
    <div>
      <h4 class="font-bold text-base mb-2 text-red-400">Business Risk</h4>
      <p class="text-gray-300">Accessibility lawsuits threatened revenue and reputation</p>
    </div>
    <div>
      <h4 class="font-bold text-base mb-2 text-orange-400">Financial Impact</h4>
      <p class="text-gray-300">$1.2M annual waste in rework, support overhead, and lost velocity</p>
    </div>
    <div>
      <h4 class="font-bold text-base mb-2 text-yellow-400">Team Morale</h4>
      <p class="text-gray-300">Designer burnout and engineer frustration impacting retention</p>
    </div>
    <div>
      <h4 class="font-bold text-base mb-2 text-blue-400">Competitive Disadvantage</h4>
      <p class="text-gray-300">Slow feature delivery preventing us from keeping pace with competitors</p>
    </div>
  </div>
</div>