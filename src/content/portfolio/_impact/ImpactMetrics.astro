---
import DeveloperQuotesCard from "@/components/UI/Cards/DeveloperQuotesCard.astro";
---


<div class="grid grid-cols-4 gap-4 mb-4">
  <div class="purple-gradient rounded-lg p-6 text-center">
    <div class="text-4xl font-bold text-purple-600 mb-2">91%</div>
    <div class="text-sm text-gray-700 dark:text-gray-300 mb-1">Developer Adoption</div>
    <div class="text-xs text-gray-500 dark:text-gray-400">within 3 months</div>
  </div>
  <div class="blue-gradient rounded-lg p-6 text-center">
    <div class="text-4xl font-bold text-blue-600 mb-2">87%</div>
    <div class="text-sm text-gray-700 dark:text-gray-300 mb-1">Issues Caught in IDE</div>
    <div class="text-xs text-gray-500 dark:text-gray-400">before commit</div>
  </div>
  <div class="green-gradient rounded-lg p-6 text-center">
    <div class="text-4xl font-bold text-green-600 mb-2">4.8/5</div>
    <div class="text-sm text-gray-700 dark:text-gray-300 mb-1">Overall Satisfaction</div>
    <div class="text-xs text-gray-500 dark:text-gray-400">n=68 developers</div>
  </div>
  <div class="orange-gradient rounded-lg p-6 text-center">
    <div class="text-4xl font-bold text-orange-600 mb-2">62%</div>
    <div class="text-sm text-gray-700 dark:text-gray-300 mb-1">Faster Onboarding</div>
    <div class="text-xs text-gray-500 dark:text-gray-400">new developers</div>
  </div>
</div>

<DeveloperQuotesCard/>