---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import ProjectDetails from '../../components/portfolio/ProjectDetails.astro';
import TechStack from '../../components/portfolio/TechStack.astro';
import ProcessSection from '../../components/portfolio/ProcessSection.astro';
import ImageGallery from '../../components/portfolio/ImageGallery.astro';
import ContentSection from '../../components/portfolio/ContentSection.astro';
import BenefitsSection from '../../components/portfolio/BenefitsSection.astro';
import { Button } from '../../components/ui/Button.astro';

const features = [
  { icon: "blue", text: "150+ production-ready UI components" },
  { icon: "blue", text: "Comprehensive design token system" },
  { icon: "blue", text: "WCAG 2.1 AA accessibility compliance" },
  { icon: "blue", text: "Multi-framework support (React, Angular, Web Components)" },
  { icon: "blue", text: "Automated testing and visual regression" }
];

const metrics = [
  { icon: "green", text: "38% reduction in time to market for new features" },
  { icon: "green", text: "9+ point increase in usability scores" },
  { icon: "green", text: "Consistent experience across 80+ applications" }
];

const techCategories = [
  {
    title: "Frontend Technologies",
    technologies: [
      { name: "React", gradient: "from-blue-500 to-cyan-500" },
      { name: "Angular", gradient: "from-red-500 to-pink-500" },
      { name: "TypeScript", gradient: "from-yellow-500 to-orange-500" }
    ]
  },
  {
    title: "Development Tools",
    technologies: [
      { name: "Storybook", gradient: "from-orange-500 to-red-500" },
      { name: "Jest", gradient: "from-green-500 to-emerald-500" },
      { name: "Figma", gradient: "from-purple-500 to-violet-500" }
    ]
  }
];

const processSteps = [
  {
    title: "Building the Team",
    content: `
      <p class="mb-6">To begin with I had to build an internal team using a small percentage of each designer's time. This meant I needed to be extremely well organized when running meetings.</p>
      <p>I made sure the entire UX team was working together and we had consistent meetings across teams and with product owners in order to maintain a visible and deliverable roadmap.</p>
    `
  },
  {
    title: "Interface Inventory Process",
    content: `
      <p class="mb-6">I began the process of understanding all existing UI components and dependencies within our applications. I considered this the "interface inventory" process.</p>
      <p>I then presented these results to the entire UX team and engaged their individual domain knowledge to formulate a plan of action.</p>
    `
  }
];

const designImages = [
  { src: "/openmenu.jpg", alt: "Sketch Design Library - Open Menu" },
  { src: "/cardsketch.jpg", alt: "Sketch Design Library - Card Sketch" },
  { src: "/avatar-overrides.jpg", alt: "Sketch Design Library - Avatar Overrides" },
  { src: "/actionsketch.jpg", alt: "Sketch Design Library - Action Sketch" }
];

const codeImages = [
  { src: "/lint.jpg", alt: "Stylelint for SCSS linting" },
  { src: "/true.jpg", alt: "True for SCSS unit testing" },
  { src: "/alerts.jpg", alt: "Alert Components" },
  { src: "/avatars.jpg", alt: "Avatar Components" },
  { src: "/badges.jpg", alt: "Badge Components" },
  { src: "/layout.jpg", alt: "Layout Components" }
];

const exampleImages = [
  { src: "/example-a.jpg", alt: "Application Example A", borderColor: "blue" },
  { src: "/example-b.jpg", alt: "Application Example B", borderColor: "purple" },
  { src: "/example-c.jpg", alt: "Application Example C", borderColor: "green" },
  { src: "/example-d.jpg", alt: "Application Example D", borderColor: "orange" },
  { src: "/example-e.jpg", alt: "Application Example E", borderColor: "red" },
  { src: "/example-g.jpg", alt: "Application Example G", borderColor: "pink" }
];

const benefitGroups = [
  {
    title: "Strategic Benefits",
    benefits: [
      { icon: "green", text: "Single source of truth for building User Interface" },
      { icon: "green", text: "Time and money savings across all development teams" },
      { icon: "green", text: "Great increase in consistency across 80+ applications" },
      { icon: "green", text: "Decreased maintenance and spread of technical debt" },
      { icon: "green", text: "UX teams can focus on users, not spec sheets" },
      { icon: "green", text: "Development teams focus on features, not pixels" }
    ]
  },
  {
    title: "Day-to-Day Impact",
    benefits: [
      { icon: "blue", text: "Less, more productive meetings" },
      { icon: "blue", text: "More alignment and better collaboration" },
      { icon: "blue", text: "Culture change - working smarter not harder" },
      { icon: "blue", text: "Confidence that design will be implemented correctly" },
      { icon: "blue", text: "Teams less overwhelmed with UI bugs or inconsistencies" }
    ]
  }
];
---

<PortfolioLayout
  title="Cupcake Design System - Josh Easter Portfolio"
  description="A comprehensive, enterprise-grade design system built to scale across 80+ applications, providing consistent user experiences and accelerating development velocity."
  projectTitle="Cupcake Design System"
  projectSubtitle="A comprehensive, enterprise-grade design system built to scale across 80+ applications, providing consistent user experiences and accelerating development velocity."
  heroImage="/cupcake-docs-2.jpg"
  gradientColors="from-blue-400 via-purple-400 to-pink-400"
>
  <div slot="hero-content">
    <h3 class="text-2xl font-semibold text-white mb-2">Design System Components</h3>
    <p class="text-slate-300">Comprehensive UI library with 150+ components</p>
  </div>

  <ProjectDetails
    title="Project Overview"
    description="The Cupcake Design System was built from the ground up to serve as the foundation for IHS Markit's entire digital ecosystem. This comprehensive system includes UI components, design tokens, patterns, and guidelines that ensure consistency across all user touchpoints."
    features={features}
    metrics={metrics}
  >
    <TechStack
      title="Technical Stack"
      categories={techCategories}
      additionalInfo={[
        "Atomic Design Principles",
        "Design Token Architecture", 
        "Component-Driven Development",
        "Accessibility-First Approach"
      ]}
    />
  </ProjectDetails>

  <ProcessSection
    title="Project Process"
    steps={processSteps}
  />

  <ContentSection title="Design Deliverables">
    <div class="grid lg:grid-cols-2 gap-12">
      <div>
        <p class="text-slate-300 mb-6 leading-relaxed">
          The first deliverable for the team was a shared design library. We needed all designers to be working with the same design elements.
        </p>
        <p class="text-slate-300 mb-6 leading-relaxed">
          We also needed feedback and guidance on how to best support each persona a product team supported. The tool of choice was Sketch.
        </p>
        <p class="text-slate-300 leading-relaxed">
          While the library itself is internal and cannot be shared - these screens highlight some of the features.
        </p>
      </div>

      <ImageGallery images={designImages} columns="2" />
    </div>
  </ContentSection>

  <ContentSection title="Code Deliverables" backgroundColor="bg-slate-800">
    <div class="grid lg:grid-cols-2 gap-12">
      <div class="order-2 lg:order-1">
        <ImageGallery images={codeImages} columns="2" />
      </div>

      <div class="order-1 lg:order-2">
        <p class="text-slate-300 mb-6 leading-relaxed">
          While design decisions were being made and adopted, I started my team's sprints - building out the core code.
        </p>
        <p class="text-slate-300 mb-6 leading-relaxed">
          We first built the HTML/SCSS core with comprehensive testing and quality assurance tools including Stylelint for linting and True for SCSS unit testing.
        </p>
        <p class="text-slate-300 mb-8 leading-relaxed">
          We have since started working on an Angular library as well - affectionately named "Sprinkles" - because duh.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/portfolio/cupcake-css" class="px-6 py-3 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 rounded-lg text-white font-medium transition-all duration-300 text-center">
            View HTML Case Study
          </a>
          <a href="/portfolio/cupcake-sprinkles" class="px-6 py-3 border border-slate-600 hover:border-slate-400 rounded-lg text-slate-300 hover:text-white font-medium transition-all duration-300 text-center">
            View Angular Case Study
          </a>
        </div>
      </div>
    </div>
  </ContentSection>

  <ContentSection title="Real Application Examples" backgroundColor="bg-slate-800">
    <p class="text-slate-300 mb-12 text-lg leading-relaxed">
      Since starting this project, there have been dozens of new applications, pages, and features launched.
      I'm quite proud of the work my teams have produced. You can view a few examples below.
    </p>

    <ImageGallery images={exampleImages} />
  </ContentSection>

  <ContentSection backgroundColor="bg-slate-900">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <div class="rounded-xl overflow-hidden lightbox-trigger cursor-pointer group">
          <img src="/matrix.jpg" alt="Design System Impact Matrix" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-300" />
        </div>
      </div>

      <div>
        <h2 class="text-3xl font-bold mb-8 text-white">Business Impact</h2>
        <BenefitsSection 
          title=""
          backgroundColor="transparent"
          benefitGroups={benefitGroups}
        />
      </div>
    </div>
  </ContentSection>

  <ContentSection backgroundColor="bg-slate-800">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-8 text-white">In Summary</h2>
      <div class="space-y-6 text-slate-300 text-lg leading-relaxed">
        <p>
          The Cupcake Design System has been a great success. Cupcake has provided consistency across applications that the company had never seen before.
        </p>
        <p>
          Product Owners and Users are extremely happy with the amount of speed we have gained in delivering features. Developers are thrilled to no longer concern themselves with a ton of small CSS bugs and designers are happy to see their designs delivered as intended.
        </p>
        <p>
          Cupcake completely changed our company culture and brought design thinking to the center of everything we build. No one approaches anything UX/UI related without thinking about Cupcake first.
        </p>
      </div>
    </div>
  </ContentSection>
</PortfolioLayout>
