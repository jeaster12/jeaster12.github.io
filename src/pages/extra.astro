---
import Layout from '@layouts/Layout.astro'
import Section from '@/components/UI/Section.astro'
import Card2 from '@/components/UI/Extras/Card2.astro'
import PageTitle from '@/components/UI/Extras/PageTitle.astro'
import BlogStyle2 from '@/components/UI/Extras/BlogStyle2.astro'
import ContentFeature from '@/components/UI/Extras/ContentFeature.astro'
---

<Layout>
	<Section id="extra" showHeader={false}>
		<h2 class="text-3xl lg:text-4xl  font-semibold dark:text-white mb-3">Page Title</h2>

		<PageTitle title="Extra Ideas" description="Some extra ideas for your website" />

		<hr class="my-6" />

		<Card2 />

		<hr class="my-6" />

		<BlogStyle2 />

		<hr class="my-6" />

		<ContentFeature />
	</Section>
</Layout>
