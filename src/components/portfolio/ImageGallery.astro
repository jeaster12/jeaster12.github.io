---
export interface GalleryImage {
  src: string;
  alt: string;
  title?: string;
  description?: string;
  borderColor?: string;
}

export interface Props {
  title?: string;
  description?: string;
  images: GalleryImage[];
  columns?: 'auto' | '2' | '3' | '4';
  className?: string;
}

const { 
  title, 
  description, 
  images, 
  columns = 'auto',
  className = ''
} = Astro.props;

const getGridClass = () => {
  switch (columns) {
    case '2': return 'grid-cols-2';
    case '3': return 'grid-cols-3';
    case '4': return 'grid-cols-4';
    default: return 'md:grid-cols-2 lg:grid-cols-3';
  }
};
---

<div class={className}>
  {title && (
    <h2 class="text-3xl font-bold mb-4 text-white">{title}</h2>
  )}
  
  {description && (
    <p class="text-slate-300 mb-8 leading-relaxed">{description}</p>
  )}

  <div class={`grid ${getGridClass()} gap-6`}>
    {images.map(image => (
      <div class={`group lightbox-trigger cursor-pointer ${image.borderColor ? 'border border-slate-700 hover:border-' + image.borderColor + '-500' : ''} transition-colors rounded-xl overflow-hidden`}>
        <div class="aspect-video rounded-lg overflow-hidden">
          <img 
            src={image.src} 
            alt={image.alt} 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
          />
        </div>
        {(image.title || image.description) && (
          <div class="p-4">
            {image.title && (
              <h3 class="text-lg font-semibold text-white mb-2">{image.title}</h3>
            )}
            {image.description && (
              <p class="text-slate-400 text-sm">{image.description}</p>
            )}
          </div>
        )}
      </div>
    ))}
  </div>
</div>
