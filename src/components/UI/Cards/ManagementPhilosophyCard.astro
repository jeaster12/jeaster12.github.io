---
import { Icon } from 'astro-icon/components';
---

<div class="card-purple mb-8">
  <h3 class="font-bold text-gray-900 mb-2 flex items-center gap-2 dark:text-gray-200">
    <Icon name="line-md:heart-twotone" class="text-purple-600 text-xl dark:text-purple-600" />
    Management Philosophy & Practices
  </h3>

  <div class="grid md:grid-cols-3 gap-6">
    <div class="bg-white/70 rounded-lg p-4 dark:bg-black/20">
      <h4 class="font-semibold text-gray-900 mb-2 flex items-center gap-2 dark:text-gray-200">
        <Icon name="line-md:calendar" class="text-blue-600 text-lg dark:text-blue-600" />
        1:1 Structure
      </h4>
      <ul class="space-y-2 text-sm text-gray-700 pl-0 mb-0 dark:text-gray-400">
        <li class="flex items-start gap-2 pl-0.5">
          <Icon name="line-md:circle-to-confirm-circle-transition" class="text-blue-500 mt-1 flex-shrink-0 text-xs" />
          <span><strong>Weekly 30min</strong> for all reports</span>
        </li>
        <li class="flex items-start gap-2 pl-0.5">
          <Icon name="line-md:circle-to-confirm-circle-transition" class="text-blue-500 mt-1 flex-shrink-0 text-xs" />
          <span><strong>Monthly skip-levels</strong> with extended team</span>
        </li>
        <li class="flex items-start gap-2 pl-0.5">
          <Icon name="line-md:circle-to-confirm-circle-transition" class="text-blue-500 mt-1 flex-shrink-0 text-xs" />
          <span><strong>Career development</strong> focus quarterly</span>
        </li>
        <li class="flex items-start gap-2 pl-0.5">
          <Icon name="line-md:circle-to-confirm-circle-transition" class="text-blue-500 mt-1 flex-shrink-0 text-xs" />
          <span><strong>Shared doc</strong> for async updates</span>
        </li>
      </ul>
    </div>

    <div class="bg-white/70 rounded-lg p-4 dark:bg-black/20">
      <h4 class="font-semibold text-gray-900 mb-2 flex items-center gap-2 dark:text-gray-200">
        <Icon name="line-md:lightbulb-twotone" class="text-purple-600 text-lg dark:text-purple-600" />
        Mentorship Approach
      </h4>
      <ul class="space-y-2 text-sm text-gray-700 pl-0 mb-0 dark:text-gray-400">
        <li class="flex items-start gap-2 pl-0.5">
          <Icon name="line-md:circle-to-confirm-circle-transition" class="text-purple-500 mt-1 flex-shrink-0 text-xs" />
          <span><strong>Code reviews</strong> as teaching moments</span>
        </li>
        <li class="flex items-start gap-2 pl-0.5">
          <Icon name="line-md:circle-to-confirm-circle-transition" class="text-purple-500 mt-1 flex-shrink-0 text-xs" />
          <span><strong>Pair programming</strong> on complex problems</span>
        </li>
        <li class="flex items-start gap-2 pl-0.5">
          <Icon name="line-md:circle-to-confirm-circle-transition" class="text-purple-500 mt-1 flex-shrink-0 text-xs" />
          <span><strong>Design docs</strong> with feedback loops</span>
        </li>
        <li class="flex items-start gap-2 pl-0.5">
          <Icon name="line-md:circle-to-confirm-circle-transition" class="text-purple-500 mt-1 flex-shrink-0 text-xs" />
          <span><strong>Stretch projects</strong> with safety nets</span>
        </li>
      </ul>
    </div>

    <div class="bg-white/70 rounded-lg p-4 dark:bg-black/20">
      <h4 class="font-semibold text-gray-900 mb-2 flex items-center gap-2 dark:text-gray-200">
        <Icon name="line-md:navigation-right-up" class="text-green-600 text-lg dark:text-green-600" />
        Growth Framework
      </h4>
      <ul class="space-y-2 text-sm text-gray-700 pl-0 mb-0 dark:text-gray-400">
        <li class="flex items-start gap-2 pl-0.5">
          <Icon name="line-md:circle-to-confirm-circle-transition" class="text-green-500 mt-1 flex-shrink-0 text-xs" />
          <span><strong>Clear promotion goals</strong> aligned to ladder</span>
        </li>
        <li class="flex items-start gap-2 pl-0.5">
          <Icon name="line-md:circle-to-confirm-circle-transition" class="text-green-500 mt-1 flex-shrink-0 text-xs" />
          <span><strong>Growth plans</strong> with 6-month milestones</span>
        </li>
        <li class="flex items-start gap-2 pl-0.5">
          <Icon name="line-md:circle-to-confirm-circle-transition" class="text-green-500 mt-1 flex-shrink-0 text-xs" />
          <span><strong>Sponsorship</strong> for high-visibility work</span>
        </li>
        <li class="flex items-start gap-2 pl-0.5">
          <Icon name="line-md:circle-to-confirm-circle-transition" class="text-green-500 mt-1 flex-shrink-0 text-xs" />
          <span><strong>Calibration</strong> across peer teams</span>
        </li>
      </ul>
    </div>
  </div>
</div>
