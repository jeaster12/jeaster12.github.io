---
// Modern Josh Easter Portfolio
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Josh Easter - Senior Director of Engineering</title>
    <meta name="description" content="Experienced UX Director leading enterprise-level design and development initiatives across complex platforms and tools." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-slate-900 text-white font-sans antialiased">
    <div id="app">
      <!-- Navigation -->
      <nav class="fixed top-0 left-0 right-0 z-50 bg-slate-900/95 backdrop-blur-sm border-b border-slate-800">
        <div class="max-w-6xl mx-auto px-6 py-4">
          <div class="flex items-center justify-between">
            <div class="font-bold text-xl text-white">Josh Easter</div>
            <div class="hidden md:flex items-center space-x-8">
              <a href="#home" class="text-slate-300 hover:text-white transition-colors">Home</a>
              <a href="#about" class="text-slate-300 hover:text-white transition-colors">About</a>
              <a href="#skills" class="text-slate-300 hover:text-white transition-colors">Skills</a>
              <a href="#experience" class="text-slate-300 hover:text-white transition-colors">Experience</a>
              <a href="#portfolio" class="text-slate-300 hover:text-white transition-colors">Portfolio</a>
              <a href="#contact" class="text-slate-300 hover:text-white transition-colors">Contact</a>
            </div>
          </div>
        </div>
      </nav>

      <!-- Hero Section -->
      <section id="home" class="min-h-screen flex items-center justify-center relative bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
        <div class="absolute inset-0 bg-gradient-to-br from-blue-600/10 via-purple-600/10 to-pink-600/10"></div>
        <div class="relative z-10 text-center max-w-4xl mx-auto px-6">
          <div class="mb-8">
            <h1 class="text-6xl md:text-8xl font-bold mb-6 bg-gradient-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">
              Josh Easter
            </h1>
            <div class="text-xl md:text-2xl text-slate-300 mb-8 font-light">
              <span class="block">Senior Director of Engineering</span>
              <span class="block mt-2 text-slate-400">UI/UX Designer • Front End Developer • Design System Manager</span>
            </div>
          </div>
          
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a href="#about" class="px-8 py-3 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 rounded-full text-white font-medium transition-all duration-300 shadow-lg hover:shadow-xl">
              Learn More
            </a>
            <a href="/resume.pdf" class="px-8 py-3 border border-slate-600 hover:border-slate-400 rounded-full text-slate-300 hover:text-white font-medium transition-all duration-300">
              Download Resume
            </a>
          </div>

          <!-- Social Links -->
          <div class="flex justify-center space-x-6 mt-12">
            <a href="https://www.linkedin.com/in/josh-easter-30282625/" target="_blank" class="text-slate-400 hover:text-blue-400 transition-colors">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
            <a href="https://github.com/jeaster12" target="_blank" class="text-slate-400 hover:text-white transition-colors">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
            </a>
            <a href="mailto:jeaster12@gmail.com" class="text-slate-400 hover:text-blue-400 transition-colors">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819L11.18 14.71c-.316-.316-.883-.316-1.2 0L2.454 21.002H1.636C.732 21.002 0 20.27 0 19.366V5.457c0-.904.732-1.636 1.636-1.636h20.728c.904 0 1.636.732 1.636 1.636z"/>
              </svg>
            </a>
          </div>
        </div>
      </section>

      <!-- About Section -->
      <section id="about" class="py-20 bg-slate-800">
        <div class="max-w-6xl mx-auto px-6">
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div>
              <h2 class="text-4xl font-bold mb-6 text-white">About Me</h2>
              <p class="text-slate-300 text-lg mb-6 leading-relaxed">
                Experienced UX Director leading enterprise-level design and development initiatives across complex platforms and tools. Passionate about human-centered design, scalable UX/UI architecture, and cross-functional leadership.
              </p>
              <p class="text-slate-300 mb-8 leading-relaxed">
                Proven success in improving usability, performance, and design consistency across digital products.
              </p>
              
              <div class="space-y-4 mb-8">
                <h3 class="text-xl font-semibold text-white">A Few Things About Me</h3>
                <ul class="space-y-2 text-slate-300">
                  <li class="flex items-start">
                    <span class="text-blue-400 mr-2">•</span>
                    Father & Husband. Always learning. Can't grow a beard.
                  </li>
                  <li class="flex items-start">
                    <span class="text-blue-400 mr-2">•</span>
                    Musician & Occasional Audio Engineer.
                  </li>
                  <li class="flex items-start">
                    <span class="text-blue-400 mr-2">��</span>
                    Lover of Coffee & Wine
                  </li>
                  <li class="flex items-start">
                    <span class="text-blue-400 mr-2">•</span>
                    Total tech geek. Never far away from an Apple product.
                  </li>
                  <li class="flex items-start">
                    <span class="text-blue-400 mr-2">•</span>
                    I love most sports but I am a huge baseball fan. GO RED SOX!
                  </li>
                </ul>
              </div>

              <div class="flex flex-col sm:flex-row gap-4">
                <a href="/resume.pdf" class="px-6 py-3 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 rounded-lg text-white font-medium transition-all duration-300 text-center">
                  Download Resume
                </a>
                <a href="#contact" class="px-6 py-3 border border-slate-600 hover:border-slate-400 rounded-lg text-slate-300 hover:text-white font-medium transition-all duration-300 text-center">
                  Get in Touch
                </a>
              </div>
            </div>
            
            <div class="relative">
              <div class="relative z-10 rounded-2xl overflow-hidden shadow-2xl">
                <img src="/josh-profile.jpg" alt="Josh Easter" class="w-full h-auto object-cover" />
              </div>
              <div class="absolute -inset-4 bg-gradient-to-r from-blue-600/20 to-purple-600/20 rounded-3xl -z-10"></div>
            </div>
          </div>
        </div>
      </section>

      <!-- Skills Section -->
      <section id="skills" class="py-20 bg-slate-900">
        <div class="max-w-6xl mx-auto px-6">
          <div class="text-center mb-16">
            <h2 class="text-4xl font-bold mb-6 text-white">Skills & Technologies</h2>
            <p class="text-slate-300 text-lg max-w-3xl mx-auto leading-relaxed">
              I am a hybrid design engineer with talent for creating elegant user interfaces, instinctive user experiences, and expertly crafted code. I focus on building scalable design systems and leading multifunctional teams.
            </p>
          </div>

          <div class="grid md:grid-cols-3 gap-8">
            <!-- Design & Development Tools -->
            <div class="bg-slate-800 rounded-xl p-8 border border-slate-700">
              <div class="mb-6">
                <h3 class="text-xl font-semibold text-white mb-4">Design & Development</h3>
                <div class="grid grid-cols-4 gap-4">
                  <!-- Figma -->
                  <div class="flex justify-center" title="Figma">
                    <svg class="w-8 h-8 text-purple-400" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M15.5 2.25a4.5 4.5 0 0 0-3.5 7.32V8.25a4.5 4.5 0 1 0-4.5 4.5h1.25a4.5 4.5 0 1 0 4.5-4.5V6.75a4.5 4.5 0 1 0 2.25-4.5zm-7 4.5a2.25 2.25 0 1 1 4.5 0 2.25 2.25 0 0 1-4.5 0zm2.25 6.75a2.25 2.25 0 1 1 0 4.5 2.25 2.25 0 0 1 0-4.5zm4.5-2.25a2.25 2.25 0 1 1 0-4.5 2.25 2.25 0 0 1 0 4.5z"/>
                    </svg>
                  </div>
                  <!-- HTML5 -->
                  <div class="flex justify-center" title="HTML5">
                    <svg class="w-8 h-8 text-orange-400" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M3 2l1.578 17.834L12 22l7.467-2.166L21 2H3zm14.049 6.048H9.075l.172 2.016h7.697l-.626 6.565L12 18.477l-4.318-1.848-.297-3.027h2.082l.15 1.526L12 16.175l2.383-1.047.17-2.618H6.924l-.623-6.46h11.398l-.65.998z"/>
                    </svg>
                  </div>
                  <!-- CSS3 -->
                  <div class="flex justify-center" title="CSS3">
                    <svg class="w-8 h-8 text-blue-400" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M3 2l1.578 17.834L12 22l7.467-2.166L21 2H3zm12.049 6.048H9.075l.172 2.016h5.697l-.626 6.565L12 18.477l-2.318-.848-.297-3.027h2.082l.15 1.526L12 16.175l1.383-.547.17-2.618H8.924l-.623-6.46h7.398l-.65.998z"/>
                    </svg>
                  </div>
                  <!-- JavaScript -->
                  <div class="flex justify-center" title="JavaScript">
                    <svg class="w-8 h-8 text-yellow-400" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M3 3h18v18H3V3zm16.525 13.707c-.131-.821-.666-1.511-2.252-2.155-.552-.259-1.165-.438-1.349-.854-.068-.248-.078-.382-.034-.529.11-.403.595-.527.984-.404.262.08.456.286.608.676.396-.213.396-.213.671-.404-.103-.16-.145-.229-.21-.298-.226-.289-.677-.623-1.299-.623-.697.033-1.147.299-1.434.695-.597.797-.19 2.188.942 2.766.717.344 1.754.456 1.863 1.268.108.686-.456 1.012-1.07 1.012-.669 0-1.057-.347-1.279-.847l-.671.413c.234.979 1.020 1.425 2.027 1.425 1.158-.034 1.666-.674 1.653-1.918zM14.017 8.65c0 1.32-.983 1.718-2.017 1.718-.732 0-1.17-.078-1.529-.295a2.25 2.25 0 0 1-.665-.88c-.13-.315-.242-.671-.242-1.043h2.487c.034.507.034.774.034 1.043 0 .314-.034.457-.034.457h1.966z"/>
                    </svg>
                  </div>
                  <!-- TypeScript -->
                  <div class="flex justify-center" title="TypeScript">
                    <svg class="w-8 h-8 text-blue-600" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M3 3h18v18H3V3zm14.71 10.79c.18-.09.385-.165.555-.165.397 0 .718.179.718.599 0 .599-.44.959-1.263.959-.18 0-.343-.018-.48-.054v.054c.527.036 1.279.108 1.279.599 0 .419-.36.659-.748.659-.36 0-.659-.18-.659-.599 0-.36.234-.599.598-.599zm-5.999.18c0-.599.479-1.079 1.079-1.079.599 0 1.079.48 1.079 1.079 0 .599-.48 1.079-1.079 1.079-.6 0-1.079-.48-1.079-1.079z"/>
                    </svg>
                  </div>
                  <!-- Tailwind CSS -->
                  <div class="flex justify-center" title="Tailwind CSS">
                    <svg class="w-8 h-8 text-cyan-400" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12.001 4.8c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624C13.666 10.618 15.027 12 18.001 12c3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C16.337 6.182 14.976 4.8 12.001 4.8zM6.001 12c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624 1.177 1.194 2.538 2.576 5.512 2.576 3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C10.337 13.382 8.976 12 6.001 12z"/>
                    </svg>
                  </div>
                  <!-- React -->
                  <div class="flex justify-center" title="React">
                    <svg class="w-8 h-8 text-cyan-400" viewBox="0 0 24 24" fill="currentColor">
                      <circle cx="12" cy="12" r="2"/>
                      <path d="M12 1c-4.97 0-9 1.79-9 4v2c0 2.21 4.03 4 9 4s9-1.79 9-4V5c0-2.21-4.03-4-9-4z"/>
                      <path d="M21 12c0 2.21-4.03 4-9 4s-9-1.79-9-4v2c0 2.21 4.03 4 9 4s9-1.79 9-4v-2z"/>
                      <path d="M3 16v2c0 2.21 4.03 4 9 4s9-1.79 9-4v-2c0 2.21-4.03 4-9 4s-9-1.79-9-4z"/>
                    </svg>
                  </div>
                  <!-- Angular -->
                  <div class="flex justify-center" title="Angular">
                    <svg class="w-8 h-8 text-red-500" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M9.931 12.645h4.138l-2.07-4.908m0-5.737L2.795 4.1l1.717 14.904L12 22l7.488-2.996L21.205 4.1M16.855 18.843h-2.79l-1.378-3.418H9.313L7.935 18.843H5.145L12 6.485"/>
                    </svg>
                  </div>
                </div>
              </div>
              <p class="text-slate-300 text-sm">
                Figma, HTML5, CSS3, JavaScript, TypeScript, Tailwind CSS, React, Angular - Designing and building for the web with modern tools.
              </p>
            </div>

            <!-- Testing & Quality -->
            <div class="bg-slate-800 rounded-xl p-8 border border-slate-700">
              <div class="mb-6">
                <h3 class="text-xl font-semibold text-white mb-4">Testing & Quality</h3>
                <div class="grid grid-cols-4 gap-4">
                  <div class="flex justify-center">
                    <div class="w-8 h-8 bg-gradient-to-r from-green-500 to-emerald-500 rounded"></div>
                  </div>
                  <div class="flex justify-center">
                    <div class="w-8 h-8 bg-gradient-to-r from-orange-500 to-amber-500 rounded"></div>
                  </div>
                  <div class="flex justify-center">
                    <div class="w-8 h-8 bg-gradient-to-r from-purple-500 to-violet-500 rounded"></div>
                  </div>
                  <div class="flex justify-center">
                    <div class="w-8 h-8 bg-gradient-to-r from-indigo-500 to-purple-500 rounded"></div>
                  </div>
                </div>
              </div>
              <p class="text-slate-300 text-sm">
                Jest, Storybook, Playwright, Percy - Comprehensive testing strategies including unit testing, E2E testing, and visual regression testing.
              </p>
            </div>

            <!-- DevOps & Deployment -->
            <div class="bg-slate-800 rounded-xl p-8 border border-slate-700">
              <div class="mb-6">
                <h3 class="text-xl font-semibold text-white mb-4">DevOps & Deployment</h3>
                <div class="grid grid-cols-4 gap-4">
                  <div class="flex justify-center">
                    <div class="w-8 h-8 bg-gradient-to-r from-orange-600 to-red-600 rounded"></div>
                  </div>
                  <div class="flex justify-center">
                    <div class="w-8 h-8 bg-gradient-to-r from-gray-800 to-gray-600 rounded"></div>
                  </div>
                  <div class="flex justify-center">
                    <div class="w-8 h-8 bg-gradient-to-r from-orange-500 to-red-500 rounded"></div>
                  </div>
                  <div class="flex justify-center">
                    <div class="w-8 h-8 bg-gradient-to-r from-blue-600 to-blue-400 rounded"></div>
                  </div>
                </div>
              </div>
              <p class="text-slate-300 text-sm">
                Git, GitHub, GitLab, Docker - Modern development workflows with version control, CI/CD pipelines, and containerized deployment.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Experience Section -->
      <section id="experience" class="py-20 bg-slate-800">
        <div class="max-w-6xl mx-auto px-6">
          <div class="text-center mb-16">
            <h2 class="text-4xl font-bold mb-6 text-white">Experience</h2>
            <p class="text-slate-300 text-lg max-w-3xl mx-auto leading-relaxed">
              Demonstrated ability to deliver excellent results while leading a multidiscipline team with engineers, developers, designers, analysts, and marketing personnel.
            </p>
          </div>

          <div class="space-y-12">
            <!-- ADP -->
            <div class="bg-slate-900 rounded-xl p-8 border border-slate-700">
              <div class="flex flex-col lg:flex-row gap-8">
                <div class="lg:w-1/3">
                  <div class="mb-4">
                    <h3 class="text-xl font-semibold text-white">ADP</h3>
                    <p class="text-blue-400 font-medium">Senior Director of Engineering</p>
                    <p class="text-slate-400">April 2023 - Present</p>
                  </div>
                </div>
                <div class="lg:w-2/3">
                  <p class="text-slate-300 mb-6 leading-relaxed">
                    Led the UX Design System Engineering teams, managing a multidisciplinary team of designers, developers, and QA to deliver cohesive, high-impact user experiences across the firm's digital ecosystem.
                  </p>
                  <ul class="space-y-3 text-slate-300">
                    <li class="flex items-start">
                      <span class="text-blue-400 mr-2 mt-1.5 w-2 h-2 rounded-full bg-blue-400 flex-shrink-0"></span>
                      Architected UI/UX strategies that leveraged A.I. tooling to emphasize reliability, maintainability, scalability, and accessibility
                    </li>
                    <li class="flex items-start">
                      <span class="text-blue-400 mr-2 mt-1.5 w-2 h-2 rounded-full bg-blue-400 flex-shrink-0"></span>
                      Revised delivery strategies to increase output over 60% while reducing defects by 17%
                    </li>
                    <li class="flex items-start">
                      <span class="text-blue-400 mr-2 mt-1.5 w-2 h-2 rounded-full bg-blue-400 flex-shrink-0"></span>
                      Drove continuous improvement initiatives and A.I. onboarding across teams
                    </li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- IHS Markit -->
            <div class="bg-slate-900 rounded-xl p-8 border border-slate-700">
              <div class="flex flex-col lg:flex-row gap-8">
                <div class="lg:w-1/3">
                  <div class="mb-4">
                    <h3 class="text-xl font-semibold text-white">IHS Markit</h3>
                    <p class="text-blue-400 font-medium">Associate Director, Software Engineering</p>
                    <p class="text-slate-400">Dec 2020 – April 2023</p>
                  </div>
                </div>
                <div class="lg:w-2/3">
                  <p class="text-slate-300 mb-6 leading-relaxed">
                    As Product Owner & Lead developer for the design system - led a team involved in all stages of User Experience and User Interface development for 80+ products.
                  </p>
                  <ul class="space-y-3 text-slate-300">
                    <li class="flex items-start">
                      <span class="text-blue-400 mr-2 mt-1.5 w-2 h-2 rounded-full bg-blue-400 flex-shrink-0"></span>
                      Led centralized UX Engineering initiatives for 80+ enterprise applications
                    </li>
                    <li class="flex items-start">
                      <span class="text-blue-400 mr-2 mt-1.5 w-2 h-2 rounded-full bg-blue-400 flex-shrink-0"></span>
                      Decreased time to market by 38% and raised usability scores by 9+ points
                    </li>
                    <li class="flex items-start">
                      <span class="text-blue-400 mr-2 mt-1.5 w-2 h-2 rounded-full bg-blue-400 flex-shrink-0"></span>
                      Established a Center of Excellence for design and dev collaboration
                    </li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- IPREO -->
            <div class="bg-slate-900 rounded-xl p-8 border border-slate-700">
              <div class="flex flex-col lg:flex-row gap-8">
                <div class="lg:w-1/3">
                  <div class="mb-4">
                    <h3 class="text-xl font-semibold text-white">IPREO</h3>
                    <p class="text-blue-400 font-medium">Lead UI Developer</p>
                    <p class="text-slate-400">Jan 2015 - 2018</p>
                  </div>
                </div>
                <div class="lg:w-2/3">
                  <p class="text-slate-300 mb-6 leading-relaxed">
                    Utilized industry best practices to design, develop, document, and implement software solutions while working with business users and stakeholders.
                  </p>
                  <ul class="space-y-3 text-slate-300">
                    <li class="flex items-start">
                      <span class="text-blue-400 mr-2 mt-1.5 w-2 h-2 rounded-full bg-blue-400 flex-shrink-0"></span>
                      Created reusable libraries and company-wide style guide/design system
                    </li>
                    <li class="flex items-start">
                      <span class="text-blue-400 mr-2 mt-1.5 w-2 h-2 rounded-full bg-blue-400 flex-shrink-0"></span>
                      Designed, developed and maintained the company website - Ipreo.com
                    </li>
                  </ul>
