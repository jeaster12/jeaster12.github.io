---
interface Props {
  title?: string;
  command?: string;
  className?: string;
  showCommandBar?: boolean;
}

const {
  command = '',
  className = '',
  title = 'Terminal',
  showCommandBar = false,
} = Astro.props;
---

<div class={`card shadow-sm overflow-hidden h-full flex flex-col p-0 ${className}`}>
  <!-- Terminal Header -->
  <div class="flex items-center gap-1 border-b border-global px-3 py-2 text-xs text-black/70">
    <span class="inline-block size-2 rounded-full bg-red-400"></span>
    <span class="inline-block size-2 rounded-full bg-yellow-400"></span>
    <span class="inline-block size-2 rounded-full bg-green-400"></span>
    <span class="ml-2 font-medium text-black/70 dark:text-white">{title}</span>
  </div>

  <!-- Terminal Content -->
  <div class="flex-1 overflow-auto p-4">
    <slot />
  </div>

  <!-- Command Bar (optional) -->
  {showCommandBar && (
    <div class="flex items-center gap-2 border-t border-global px-4 py-2">
      <input
        readonly
        disabled
        class="w-full rounded-md border border-global dark:bg-black/40 px-3 py-2 text-xs outline-none h-9 cursor-not-allowed opacity-60"
        value={command}
      />
      <button
        disabled
        class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium dark:bg-black/40 text-white bg-black h-9 rounded-md px-3 cursor-not-allowed opacity-60">
        Run
      </button>
    </div>
  )}
</div>
