---
import { Icon } from 'astro-icon/components';
---

<section id="skills" class="py-20 bg-slate-900">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-6 text-white">Skills & Technologies</h2>
      <p class="text-slate-300 text-lg max-w-3xl mx-auto leading-relaxed">
        Designing and building for the web has changed so much in recent years but I love learning and gaining new skills. The tools will always change and evolve over time, but our skills have to evolve and adapt as well. Here are some of the powerful tools and technologies I currently use with my teams daily.
      </p>
    </div>

    <div class="grid gap-8 mb-8">
      <!-- Design & Development Tools -->
      <div class="bg-slate-800 rounded-xl p-8 border border-slate-700">
        <div class="mb-6">
          <h3 class="text-xl font-semibold text-white mb-4">Design & Development</h3>
          <div class="grid grid-cols-12 gap-4">
            <div class="flex justify-center" title="Jira">
              <Icon name="devicon:jira" class="w-8 h-8" />
            </div>
            <!-- Figma -->
            <div class="flex justify-center" title="Figma">
              <Icon name="devicon:figma" class="w-8 h-8" />
            </div>
            <!-- HTML5 -->
            <div class="flex justify-center" title="HTML5">
              <Icon name="devicon:html5" class="w-8 h-8" />
            </div>
            <!-- CSS3 -->
            <div class="flex justify-center" title="CSS3">
              <Icon name="devicon:css3" class="w-8 h-8" />
            </div>
            <!-- JavaScript -->
            <div class="flex justify-center" title="JavaScript">
              <Icon name="devicon:javascript" class="w-8 h-8" />
            </div>
            <!-- TypeScript -->
            <div class="flex justify-center" title="TypeScript">
              <Icon name="devicon:typescript" class="w-8 h-8" />
            </div>
            <!-- SCSS -->
            <div class="flex justify-center" title="Scss">
              <Icon name="devicon:sass" class="w-8 h-8" />
            </div>
            <!-- Astro -->
            <div class="flex justify-center" title="Astro">
              <Icon name="devicon:astro" class="w-8 h-8" />
            </div>
            <!-- Tailwind CSS -->
            <div class="flex justify-center" title="Tailwind CSS">
              <Icon name="devicon:tailwindcss" class="w-8 h-8" />
            </div>
            <!-- Stencil Web Components -->
            <div class="flex justify-center" title="Stencil Web Components">
              <Icon name="devicon:stenciljs" class="w-8 h-8" />
            </div>
            <!-- React -->
            <div class="flex justify-center" title="React">
              <Icon name="devicon:react" class="w-8 h-8" />
            </div>
            <!-- Angular -->
            <div class="flex justify-center" title="Angular">
              <Icon name="devicon:angular" class="w-8 h-8" />
            </div>
          </div>
        </div>
        <p class="text-slate-300 text-sm">
          Figma, HTML5, CSS3, JavaScript, TypeScript, Tailwind CSS, React, Angular - Designing and building for the web with modern tools.
        </p>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- Testing & Quality -->
      <div class="bg-slate-800 rounded-xl p-8 border border-slate-700">
        <div class="mb-6">
          <h3 class="text-xl font-semibold text-white mb-4">Testing & Quality</h3>
          <div class="grid grid-cols-4 gap-4">
            <!-- Jest -->
            <div class="flex justify-center" title="Jest">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 398.25 439.89">
                <defs>
                  <style>.a,.c{fill:#c21325;}.a,.b{stroke:#fff;stroke-width:20px;}.b{fill:none;}</style>
                </defs>
                <title>jest-js-icon</title>
                <path class="a" d="M334.92,218.1c-.54.33-18.35-2.66-40.67-4.17a447.59,447.59,0,0,0-56.74,0c-14,1-32.44-6.09-34.64,2.28-8.24,31.35-26,58.66-48.51,79.93A163.89,163.89,0,0,1,97,331.73c-25-12.84-36.81-41.4-26.16-66.44,8.45-19.87,18.28-41.74.13-46.75-13.21-3.64-20.46,9-25.54,22.55C35.69,267,17.2,293.83,11.93,325.61c-5.56,33.54,0,69.15,29,89.25,67.56,46.83,140.9-29,218.23-48.09,28-6.92,58.78-5.8,83.47-20.1a69.92,69.92,0,0,0,34.23-48.52C382.43,266,365.71,234.09,334.92,218.1Z"/>
                <path class="b" d="M202.87,216.19c-8.24,31.35-26,58.66-48.51,79.93A163.84,163.84,0,0,1,97,331.73c-25-12.84-36.8-41.4-26.15-66.44,8.45-19.87,18.28-41.74.13-46.75-13.21-3.64-20.47,9-25.54,22.55C35.69,267,17.2,293.84,11.93,325.61c-5.56,33.54,0,69.15,29,89.25,67.56,46.83,140.9-29,218.23-48.09,28-6.92,58.78-5.8,83.47-20.1a69.92,69.92,0,0,0,34.23-48.52c5.58-32.13-11.14-64.06-41.93-80"/>
                <polygon class="c" points="264.89 91.17 319.21 201.98 384.31 10 145.32 10 210.26 201.64 264.89 91.17"/>
                <polygon class="b" points="264.89 91.17 319.21 201.98 384.31 10 145.32 10 210.26 201.64 264.89 91.17"/>
                <circle class="c" cx="198.99" cy="216.58" r="40.95"/>
                <circle class="b" cx="198.99" cy="216.58" r="40.95"/>
                <circle class="a" cx="332.37" cy="216.58" r="40.95"/>
                <circle class="b" cx="332.37" cy="216.58" r="40.95"/>
                <circle class="c" cx="65.1" cy="216.88" r="40.94"/>
                <circle class="b" cx="65.1" cy="216.88" r="40.94"/>
              </svg>
            </div>
            <!-- Storybook -->
            <div class="flex justify-center" title="Storybook">
              <Icon name="devicon:storybook" class="w-8 h-8" />
            </div>
            <!-- Playwright -->
            <div class="flex justify-center" title="Playwright">
              <Icon name="devicon:playwright" class="w-8 h-8" />
            </div>
            <!-- Cypress -->
            <div class="flex justify-center" title="Cypress">
              <Icon name="devicon:cypressio" class="w-8 h-8" />
            </div>
          </div>
        </div>
        <p class="text-slate-300 text-sm">
          Jest, Storybook, Playwright, Cypress - Comprehensive testing strategies including unit testing, E2E testing, and visual regression testing.
        </p>
      </div>

      <!-- DevOps & Deployment -->
      <div class="bg-slate-800 rounded-xl p-8 border border-slate-700">
        <div class="mb-6">
          <h3 class="text-xl font-semibold text-white mb-4">DevOps & Deployment</h3>
          <div class="grid grid-cols-4 gap-4">
            <!-- Git -->
            <div class="flex justify-center" title="Git">
              <Icon name="devicon:git" class="w-8 h-8" />
            </div>
            <!-- GitHub -->
            <div class="flex justify-center" title="GitHub">
              <Icon name="devicon:github" class="w-8 h-8" />
            </div>
            <!-- GitLab -->
            <div class="flex justify-center" title="GitLab">
              <Icon name="devicon:gitlab" class="w-8 h-8" />
            </div>
            <!-- Docker -->
            <div class="flex justify-center" title="Docker">
              <Icon name="devicon:docker" class="w-8 h-8" />
            </div>
          </div>
        </div>
        <p class="text-slate-300 text-sm">
          Git, GitHub, GitLab, Docker - Modern development workflows with version control, CI/CD pipelines, and containerized deployment.
        </p>
      </div>
    </div>
  </div>
</section>
