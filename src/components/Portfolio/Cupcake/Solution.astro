    {
      icon: 'line-md:lightbulb-twotone',
      iconColor: 'text-primary-500',
      title: 'Three-Tier Design System Architecture',
      description: 'Built a scalable, technology-agnostic design system with three distinct layers: design foundations, core HTML/SCSS library, and framework-specific implementations.',
      subgrid: {
        columns: 3,
        items: [
          {
            icon: 'logos:sketch',
            title: 'Design Foundations',
            description: 'Shared Sketch library with design tokens, patterns, and comprehensive persona guidance'
          },
          {
            icon: 'logos:html-5',
            title: 'Cupcake Core (HTML/SCSS)',
            description: 'Technology-agnostic foundation with design tokens, utilities, and base components'
          },
          {
            icon: 'logos:angular-icon',
            title: 'Cupcake Sprinkles (Angular)',
            description: 'Production-ready Angular component library built via internal hackathon'
