---
import SectionTitle from '@/components/UI/SectionTitle.astro';
import TeamGrowthCard from '@/components/UI/Cards/TeamGrowthCard.astro';
import TeamStructureCard from '@/components/UI/Cards/TeamStructureCard.astro';
import TeamLeadershipCard from '@/components/UI/Cards/TeamLeadershipCard.astro';
import ManagementPhilosophyCard from '@/components/UI/Cards/ManagementPhilosophyCard.astro';
import ManagingSeniorEngineersCard from '@/components/UI/Cards/ManagingSeniorEngineersCard.astro';
---


<section class="mb-16">
  <TeamLeadershipCard />
