---
export interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  borderColor?: string;
  className?: string;
}

const { 
  title, 
  description, 
  image, 
  imageAlt, 
  borderColor = 'blue',
  className = ''
} = Astro.props;
---

<div class={`bg-slate-800 rounded-xl p-6 border border-slate-700 hover:border-${borderColor}-500 transition-colors ${className}`}>
  <div class="aspect-video rounded-lg mb-4 overflow-hidden lightbox-trigger cursor-pointer group">
    <img 
      src={image} 
      alt={imageAlt} 
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
    />
  </div>
  <h3 class="text-lg font-semibold text-white mb-2">{title}</h3>
  <p class="text-slate-400 text-sm">{description}</p>
</div>
