---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import ProjectDetails from '../../components/portfolio/ProjectDetails.astro';
import TechStack from '../../components/portfolio/TechStack.astro';
import ContentSection from '../../components/portfolio/ContentSection.astro';
import ImageGallery from '../../components/portfolio/ImageGallery.astro';
import FeatureCard from '../../components/portfolio/FeatureCard.astro';
import BenefitsSection from '../../components/portfolio/BenefitsSection.astro';

const features = [
  { icon: "orange", text: "75+ Angular components with TypeScript" },
  { icon: "orange", text: "Full integration with Cupcake Design System" },
  { icon: "orange", text: "Reactive forms and validation support" },
  { icon: "orange", text: "Accessibility-first component design" },
  { icon: "orange", text: "Tree-shakeable modular architecture" },
  { icon: "orange", text: "Comprehensive unit test coverage" }
];

const metrics = [
  { icon: "red", text: "45+ teams using Sprinkles in production" },
  { icon: "red", text: "99.5% uptime across all implementations" },
  { icon: "red", text: "40% reduction in Angular development time" }
];

const techCategories = [
  {
    title: "Angular Stack",
    technologies: [
      { name: "Angular", gradient: "from-red-500 to-pink-500" },
      { name: "TypeScript", gradient: "from-blue-500 to-cyan-500" },
      { name: "RxJS", gradient: "from-purple-500 to-violet-500" }
    ]
  },
  {
    title: "Development Tools",
    technologies: [
      { name: "Angular CLI", gradient: "from-red-600 to-orange-600" },
      { name: "Jasmine", gradient: "from-green-500 to-emerald-500" },
      { name: "Protractor", gradient: "from-orange-500 to-yellow-500" }
    ]
  }
];

const componentExamples = [
  {
    title: "Form Components",
    description: "Advanced form controls with validation, error handling, and accessibility features.",
    image: "/angular-forms.jpg",
    imageAlt: "Angular Form Components",
    borderColor: "blue"
  },
  {
    title: "Data Tables",
    description: "Feature-rich data tables with sorting, filtering, pagination, and export capabilities.",
    image: "/angular-tables.jpg",
    imageAlt: "Angular Data Table Components",
    borderColor: "green"
  },
  {
    title: "Navigation",
    description: "Comprehensive navigation components including menus, breadcrumbs, and sidebars.",
    image: "/angular-nav.jpg",
    imageAlt: "Angular Navigation Components",
    borderColor: "purple"
  },
  {
    title: "Charts & Graphs",
    description: "Interactive data visualization components built with D3.js integration.",
    image: "/angular-charts.jpg",
    imageAlt: "Angular Chart Components",
    borderColor: "orange"
  },
  {
    title: "Modal & Overlays",
    description: "Flexible modal dialogs, tooltips, and overlay components with focus management.",
    image: "/angular-modals.jpg",
    imageAlt: "Angular Modal Components",
    borderColor: "pink"
  },
  {
    title: "Layout System",
    description: "Responsive layout components with CSS Grid and Flexbox utilities.",
    image: "/angular-layout.jpg",
    imageAlt: "Angular Layout Components",
    borderColor: "indigo"
  }
];

const codeImages = [
  { src: "/angular-component.jpg", alt: "Angular Component Structure" },
  { src: "/typescript-interfaces.jpg", alt: "TypeScript Interface Definitions" },
  { src: "/angular-service.jpg", alt: "Angular Service Implementation" },
  { src: "/angular-testing.jpg", alt: "Angular Component Testing" }
];

const benefitGroups = [
  {
    title: "For Angular Developers",
    benefits: [
      { icon: "orange", text: "Native Angular implementation with full TypeScript support" },
      { icon: "orange", text: "Reactive programming patterns with RxJS integration" },
      { icon: "orange", text: "Angular CLI schematic support for rapid scaffolding" },
      { icon: "orange", text: "Comprehensive documentation and code examples" }
    ]
  },
  {
    title: "For Enterprise Teams",
    benefits: [
      { icon: "red", text: "Production-tested components across 45+ applications" },
      { icon: "red", text: "Consistent design language across all Angular projects" },
      { icon: "red", text: "Automated testing and quality assurance pipelines" },
      { icon: "red", text: "Enterprise security and accessibility compliance" }
    ]
  }
];
---

<PortfolioLayout
  title="Cupcake Sprinkles (Angular) - Josh Easter Portfolio"
  description="A comprehensive Angular component library built on top of the Cupcake Design System, providing enterprise-grade UI components."
  projectTitle="Cupcake Sprinkles"
  projectSubtitle="A comprehensive Angular component library that brings the Cupcake Design System to Angular applications with TypeScript support and enterprise-grade features."
  heroImage="/sprinkles.jpg"
  gradientColors="from-orange-400 via-red-400 to-pink-400"
>
  <div slot="hero-content">
    <h3 class="text-2xl font-semibold text-white mb-2">Angular Components</h3>
    <p class="text-slate-300">Enterprise-ready Angular component library</p>
  </div>

  <ProjectDetails
    title="Library Overview"
    description="Cupcake Sprinkles was developed as the Angular implementation of our design system, providing developers with a comprehensive set of components that maintain design consistency while leveraging Angular's powerful features like dependency injection, reactive forms, and change detection."
    features={features}
    metrics={metrics}
  >
    <TechStack
      title="Technical Architecture"
      categories={techCategories}
      additionalInfo={[
        "Angular Universal SSR support",
        "OnPush change detection strategy",
        "Angular Material CDK integration",
        "Automated accessibility testing with axe-core"
      ]}
    />
  </ProjectDetails>

  <ContentSection title="Component Library">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {componentExamples.map(component => (
        <FeatureCard
          title={component.title}
          description={component.description}
          image={component.image}
          imageAlt={component.imageAlt}
          borderColor={component.borderColor}
        />
      ))}
    </div>

    <div class="grid lg:grid-cols-2 gap-12">
      <div>
        <h3 class="text-2xl font-semibold text-white mb-6">Development Approach</h3>
        <p class="text-slate-300 mb-6 leading-relaxed">
          Each component in Sprinkles follows Angular best practices and design patterns. We use OnPush change detection for optimal performance and implement proper lifecycle management.
        </p>
        <p class="text-slate-300 mb-6 leading-relaxed">
          The library includes comprehensive TypeScript interfaces for all component inputs and outputs, ensuring type safety and excellent developer experience with IDE support.
        </p>
        <p class="text-slate-300 mb-8 leading-relaxed">
          All components are built with accessibility in mind, following WCAG guidelines and including proper ARIA attributes, keyboard navigation, and focus management.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="http://cupcake-sprinkles.surge.sh" target="_blank" class="px-6 py-3 bg-gradient-to-r from-orange-600 to-red-600 hover:from-orange-700 hover:to-red-700 rounded-lg text-white font-medium transition-all duration-300 text-center">
            View Live Demo
          </a>
          <a href="/portfolio/cupcake-design-system" class="px-6 py-3 border border-slate-600 hover:border-slate-400 rounded-lg text-slate-300 hover:text-white font-medium transition-all duration-300 text-center">
            Design System
          </a>
        </div>
      </div>

      <ImageGallery images={codeImages} columns="2" />
    </div>
  </ContentSection>

  <ContentSection title="Implementation Examples" backgroundColor="bg-slate-800">
    <div class="space-y-12">
      <div>
        <h3 class="text-2xl font-semibold text-white mb-6">Component Usage</h3>
        <div class="bg-slate-900 rounded-xl p-6 border border-slate-700">
          <pre class="text-green-400 font-mono text-sm overflow-x-auto">
<code>import { CupcakeModule } from '@cupcake/sprinkles';

@NgModule({
  imports: [CupcakeModule.forRoot()],
  // ...
})
export class AppModule { }

// Component usage
&lt;cupcake-button 
  [variant]="'primary'" 
  [size]="'large'"
  (click)="handleClick()"&gt;
  Click Me
&lt;/cupcake-button&gt;</code>
          </pre>
        </div>
      </div>

      <div>
        <h3 class="text-2xl font-semibold text-white mb-6">Form Integration</h3>
        <div class="bg-slate-900 rounded-xl p-6 border border-slate-700">
          <pre class="text-blue-400 font-mono text-sm overflow-x-auto">
<code>&lt;form [formGroup]="userForm" (ngSubmit)="onSubmit()"&gt;
  &lt;cupcake-input
    formControlName="email"
    label="Email Address"
    placeholder="Enter your email"
    [required]="true"
    [errorMessages]="emailErrors"&gt;
  &lt;/cupcake-input&gt;
  
  &lt;cupcake-select
    formControlName="department"
    label="Department"
    [options]="departments"
    [multiple]="false"&gt;
  &lt;/cupcake-select&gt;
&lt;/form&gt;</code>
          </pre>
        </div>
      </div>

      <div>
        <h3 class="text-2xl font-semibold text-white mb-6">Data Table Implementation</h3>
        <div class="bg-slate-900 rounded-xl p-6 border border-slate-700">
          <pre class="text-purple-400 font-mono text-sm overflow-x-auto">
<code>&lt;cupcake-table
  [dataSource]="users"
  [columns]="tableColumns"
  [sortable]="true"
  [filterable]="true"
  [pagination]="true"
  [pageSize]="25"
  (sort)="handleSort($event)"
  (filter)="handleFilter($event)"&gt;
&lt;/cupcake-table&gt;</code>
          </pre>
        </div>
      </div>
    </div>
  </ContentSection>

  <BenefitsSection 
    title="Library Benefits"
    benefitGroups={benefitGroups}
  />

  <ContentSection backgroundColor="bg-slate-800">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-8 text-white">Getting Started</h2>
      <p class="text-slate-300 mb-8 text-lg leading-relaxed">
        Cupcake Sprinkles can be easily integrated into existing Angular applications or used to bootstrap new projects with a comprehensive component library.
      </p>
      
      <div class="bg-slate-900 rounded-xl p-6 border border-slate-700 mb-8">
        <pre class="text-green-400 font-mono text-sm">
<code>npm install @cupcake/sprinkles

ng add @cupcake/sprinkles

// Import the module
import { CupcakeModule } from '@cupcake/sprinkles';</code>
        </pre>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="http://cupcake-sprinkles.surge.sh" target="_blank" class="px-8 py-3 bg-gradient-to-r from-orange-600 to-red-600 hover:from-orange-700 hover:to-red-700 rounded-full text-white font-medium transition-all duration-300">
          View Documentation
        </a>
        <a href="https://github.com/cupcake-sprinkles" target="_blank" class="px-8 py-3 border border-slate-600 hover:border-slate-400 rounded-full text-slate-300 hover:text-white font-medium transition-all duration-300">
          View on GitHub
        </a>
      </div>
    </div>
  </ContentSection>
</PortfolioLayout>
