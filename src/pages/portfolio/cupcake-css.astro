---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import ProjectDetails from '../../components/portfolio/ProjectDetails.astro';
import TechStack from '../../components/portfolio/TechStack.astro';
import ContentSection from '../../components/portfolio/ContentSection.astro';
import ImageGallery from '../../components/portfolio/ImageGallery.astro';
import BenefitsSection from '../../components/portfolio/BenefitsSection.astro';

const features = [
  { icon: "purple", text: "Lightweight core with minimal footprint" },
  { icon: "purple", text: "Utility-first class naming convention" },
  { icon: "purple", text: "Responsive grid system" },
  { icon: "purple", text: "Comprehensive component library" },
  { icon: "purple", text: "SCSS-based with customizable variables" },
  { icon: "purple", text: "Cross-browser compatibility" }
];

const metrics = [
  { icon: "pink", text: "60% faster development time" },
  { icon: "pink", text: "50KB minified framework size" },
  { icon: "pink", text: "100+ utility classes available" }
];

const techCategories = [
  {
    title: "Core Technologies",
    technologies: [
      { name: "SCSS", gradient: "from-pink-500 to-rose-500" },
      { name: "PostCSS", gradient: "from-red-500 to-orange-500" },
      { name: "Autoprefixer", gradient: "from-orange-500 to-yellow-500" }
    ]
  },
  {
    title: "Build Tools",
    technologies: [
      { name: "Webpack", gradient: "from-blue-500 to-cyan-500" },
      { name: "Gulp", gradient: "from-red-600 to-pink-600" },
      { name: "npm Scripts", gradient: "from-green-500 to-emerald-500" }
    ]
  }
];

const frameworkImages = [
  { src: "/core.jpg", alt: "Cupcake CSS Core Framework" },
  { src: "/utilities.jpg", alt: "CSS Utility Classes" },
  { src: "/components.jpg", alt: "Component Library" },
  { src: "/grid-system.jpg", alt: "Responsive Grid System" }
];

const codeExamples = [
  { src: "/scss-mixins.jpg", alt: "SCSS Mixins and Functions" },
  { src: "/utility-classes.jpg", alt: "Utility Class Examples" },
  { src: "/responsive-helpers.jpg", alt: "Responsive Helper Classes" },
  { src: "/component-styles.jpg", alt: "Component Styling Examples" }
];

const benefitGroups = [
  {
    title: "For Developers",
    benefits: [
      { icon: "purple", text: "Rapid prototyping capabilities" },
      { icon: "purple", text: "Consistent naming conventions" },
      { icon: "purple", text: "Easy customization with SCSS variables" },
      { icon: "purple", text: "Minimal learning curve" }
    ]
  },
  {
    title: "For Projects",
    benefits: [
      { icon: "pink", text: "Smaller bundle sizes" },
      { icon: "pink", text: "Faster page load times" },
      { icon: "pink", text: "Maintainable codebase" },
      { icon: "pink", text: "Cross-platform compatibility" }
    ]
  }
];
---

<PortfolioLayout
  title="Cupcake CSS Framework - Josh Easter Portfolio"
  description="A lightweight, utility-first CSS framework built for rapid prototyping and scalable design systems."
  projectTitle="Cupcake CSS"
  projectSubtitle="A lightweight, utility-first CSS framework designed for rapid prototyping and building consistent user interfaces with minimal overhead."
  heroImage="/core.jpg"
  gradientColors="from-purple-400 via-pink-400 to-red-400"
>
  <div slot="hero-content">
    <h3 class="text-2xl font-semibold text-white mb-2">CSS Framework</h3>
    <p class="text-slate-300">Utility-first approach for rapid development</p>
  </div>

  <ProjectDetails
    title="Framework Overview"
    description="Cupcake CSS was designed as the foundational layer of our design system, providing a lightweight yet powerful set of utilities and components that could be easily customized and extended for any project."
    features={features}
    metrics={metrics}
  >
    <TechStack
      title="Technical Architecture"
      categories={techCategories}
      additionalInfo={[
        "Modular SCSS architecture",
        "BEM methodology for component naming",
        "Mobile-first responsive design",
        "Automated browser testing"
      ]}
    />
  </ProjectDetails>

  <ContentSection title="Framework Components">
    <div class="grid lg:grid-cols-2 gap-12 mb-16">
      <div>
        <h3 class="text-2xl font-semibold text-white mb-6">Core Utilities</h3>
        <p class="text-slate-300 mb-6 leading-relaxed">
          The framework provides a comprehensive set of utility classes for spacing, typography, colors, and layout. Each utility follows a consistent naming convention that makes it easy to understand and remember.
        </p>
        <p class="text-slate-300 mb-6 leading-relaxed">
          Built with SCSS, the framework includes mixins and functions that allow for easy customization and extension while maintaining consistency across all components.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="https://cupcake.netlify.com" target="_blank" class="px-6 py-3 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 rounded-lg text-white font-medium transition-all duration-300 text-center">
            View Live Demo
          </a>
          <a href="/portfolio/cupcake-design-system" class="px-6 py-3 border border-slate-600 hover:border-slate-400 rounded-lg text-slate-300 hover:text-white font-medium transition-all duration-300 text-center">
            Design System
          </a>
        </div>
      </div>

      <ImageGallery images={frameworkImages} columns="2" />
    </div>

    <h3 class="text-2xl font-semibold text-white mb-8">Code Architecture</h3>
    <div class="grid lg:grid-cols-2 gap-12">
      <ImageGallery images={codeExamples} columns="2" />
      
      <div>
        <p class="text-slate-300 mb-6 leading-relaxed">
          The framework is organized into logical modules that can be imported individually or as a complete package. This modular approach allows developers to include only the components they need.
        </p>
        <p class="text-slate-300 mb-6 leading-relaxed">
          Each component includes extensive documentation and usage examples, making it easy for new team members to get started quickly.
        </p>
        <p class="text-slate-300 leading-relaxed">
          The build process includes automated testing, linting, and optimization to ensure consistent quality and performance across all releases.
        </p>
      </div>
    </div>
  </ContentSection>

  <ContentSection title="Implementation Examples" backgroundColor="bg-slate-800">
    <div class="space-y-12">
      <div>
        <h3 class="text-2xl font-semibold text-white mb-6">Utility Classes</h3>
        <div class="bg-slate-900 rounded-xl p-6 border border-slate-700">
          <pre class="text-green-400 font-mono text-sm overflow-x-auto">
<code>/* Spacing utilities */
.m-1  { margin: 0.25rem; }
.p-2  { padding: 0.5rem; }
.mt-4 { margin-top: 1rem; }

/* Typography utilities */
.text-sm   { font-size: 0.875rem; }
.text-bold { font-weight: 700; }
.text-center { text-align: center; }

/* Layout utilities */
.flex      { display: flex; }
.grid      { display: grid; }
.hidden    { display: none; }</code>
          </pre>
        </div>
      </div>

      <div>
        <h3 class="text-2xl font-semibold text-white mb-6">Component Example</h3>
        <div class="bg-slate-900 rounded-xl p-6 border border-slate-700">
          <pre class="text-blue-400 font-mono text-sm overflow-x-auto">
<code>&lt;button class="btn btn--primary btn--lg"&gt;
  Primary Button
&lt;/button&gt;

&lt;div class="card p-4 m-2"&gt;
  &lt;h3 class="card__title text-lg text-bold"&gt;Card Title&lt;/h3&gt;
  &lt;p class="card__content text-sm text-muted"&gt;Card content...&lt;/p&gt;
&lt;/div&gt;</code>
          </pre>
        </div>
      </div>
    </div>
  </ContentSection>

  <BenefitsSection 
    title="Framework Benefits"
    benefitGroups={benefitGroups}
  />

  <ContentSection backgroundColor="bg-slate-800">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-8 text-white">Getting Started</h2>
      <p class="text-slate-300 mb-8 text-lg leading-relaxed">
        Cupcake CSS can be installed via npm or included directly in your project. The framework is designed to work with existing CSS and can be gradually adopted without requiring a complete rewrite.
      </p>
      
      <div class="bg-slate-900 rounded-xl p-6 border border-slate-700 mb-8">
        <pre class="text-green-400 font-mono text-sm">
<code>npm install @cupcake/css

// Or include via CDN
&lt;link rel="stylesheet" href="https://cdn.cupcake.css/v1.0.0/cupcake.min.css"&gt;</code>
        </pre>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://cupcake.netlify.com" target="_blank" class="px-8 py-3 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 rounded-full text-white font-medium transition-all duration-300">
          View Documentation
        </a>
        <a href="https://github.com/cupcake-css" target="_blank" class="px-8 py-3 border border-slate-600 hover:border-slate-400 rounded-full text-slate-300 hover:text-white font-medium transition-all duration-300">
          View on GitHub
        </a>
      </div>
    </div>
  </ContentSection>
</PortfolioLayout>
